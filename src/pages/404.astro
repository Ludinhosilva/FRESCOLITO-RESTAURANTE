---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Página no encontrada | FRESCOLITO RESTAURANTE">
  <main style="display:flex;align-items:center;justify-content:center;min-height:80vh">
    <div style="text-align:center;padding:2rem">
      <img src="/imagenes/frescolito.jpeg" alt="FRESCOLITO" style="width:120px;height:120px;border-radius:50%;object-fit:cover;margin:0 auto 1.5rem;border:4px solid var(--color-primary)" />
      <h1 style="font-family:'Pacifico',cursive;color:var(--color-primary);-webkit-text-stroke:2px var(--color-dark);paint-order:stroke fill;font-size:2.5rem;margin-bottom:0.5rem">FRESCOLITO</h1>
      <p style="color:var(--color-mid);margin-bottom:1.5rem">Esta página no está disponible</p>
      <a href="/" class="btn btn-primary">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
