---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Página no encontrada | FRESCOLITO RESTAURANTE">
  <main class="nf-page">
    <div class="nf-inner">
      <img src="/imagenes/frescolito.jpeg" alt="Frescolito" class="nf-mark" />
      <span class="section-kicker">Error 404</span>
      <h1 class="nf-title">Esta página no está disponible</h1>
      <p class="nf-text">Puede que el enlace haya cambiado o que la página ya no exista.</p>
      <a href="/" class="btn btn-primary">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>

<style>
  .nf-page {
    display: grid;
    place-items: center;
    min-height: 76vh;
    padding: 7rem 1.25rem 4rem;
    text-align: center;
  }
  .nf-inner {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    max-width: 520px;
  }
  .nf-mark {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }
  .nf-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.02em;
    color: var(--color-dark);
  }
  .nf-text {
    margin: 0 0 1rem;
    color: var(--color-mid);
    line-height: 1.7;
  }
</style>
