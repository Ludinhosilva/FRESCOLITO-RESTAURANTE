---
import BaseLayout from '../layouts/BaseLayout.astro'
import ReservationForm from '../components/react/ReservationForm.jsx'
---

<BaseLayout title="Reservas | FRESCOLITO RESTAURANTE" description="Reserva tu mesa en FRESCOLITO, Iquitos.">
  <main style="padding-top: 70px">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Reservas</h1>
        <p class="page-subtitle">Reserva tu mesa en FRESCOLITO</p>
      </div>
    </section>

    <ReservationForm client:load />
  </main>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark) 0%, #1a0e0a 100%);
    text-align: center; padding: calc(70px + var(--space-xl)) 0 var(--space-lg);
  }
  .page-title { color: var(--color-primary); }
  .page-subtitle { color: var(--color-light); margin-top: var(--space-sm); }
</style>
