---
import BaseLayout from '../layouts/BaseLayout.astro'
import ReservationForm from '../components/react/ReservationForm.jsx'
---

<BaseLayout title="Reservas | FRESCOLITO RESTAURANTE" description="Reserva tu mesa en FRESCOLITO, Iquitos." effect="slide-left">
  <main style="padding-top: 70px">
    <section class="pr-header">
      <div class="container" style="text-align:center">
        <span class="pr-label">· Reserva tu mesa ·</span>
        <h1 class="pr-title">Reservas</h1>
        <span class="pr-divider"></span>
        <p class="pr-sub">Reserva tu mesa en FRESCOLITO</p>
      </div>
    </section>
    <ReservationForm client:load />
  </main>
</BaseLayout>

<style>
  .pr-header { padding: var(--space-lg) 0 var(--space-md); }
  .pr-label {
    font-family: var(--font-body); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-mid); margin-bottom: var(--space-xs);
    display: block;
  }
  .pr-title {
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-dark);
    background: linear-gradient(90deg,
      var(--color-dark) 0%, var(--color-dark) 20%,
      var(--color-primary-hover) 50%, var(--color-dark) 80%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: pr-shine 6s ease-in-out infinite;
    margin-bottom: var(--space-sm);
  }
  @keyframes pr-shine {
    from { background-position: 200% center; }
    to { background-position: -200% center; }
  }
  .pr-divider {
    display: block; width: 30px; height: 2px;
    background: var(--color-primary); border-radius: 2px;
    margin: 0 auto var(--space-sm);
  }
  .pr-sub {
    font-family: var(--font-body); font-size: 0.9rem;
    color: var(--color-mid); margin: 0;
  }
</style>

