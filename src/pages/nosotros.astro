---
import BaseLayout from '../layouts/BaseLayout.astro'
import HorarioTexto from '../components/react/HorarioTexto.tsx'
import { WHATSAPP_NUMBER } from '../data/config.ts'

const historia = [
  { year: '2014', texto: 'Nace Frescolito en el corazón de Iquitos, con las recetas de casa y el sueño de una familia por compartir lo mejor de nuestra cocina.' },
  { year: '2016', texto: 'Ampliamos la carta y el salón. La familia de clientes creció y Frescolito se volvió un punto de encuentro en la ciudad.' },
  { year: '2019', texto: 'Renovamos la cocina y sumamos nuevos platos regionales, siempre con insumos frescos de la Amazonía.' },
  { year: '2022', texto: 'Llegamos a más hogares de Iquitos con nuestro servicio de delivery, llevando la sazón hasta la puerta de tu casa.' },
  { year: '2024', texto: 'Habilitamos el pedido en línea y modernizamos el servicio para atenderte más rápido y mejor.' },
  { year: 'Hoy', texto: 'Seguimos sirviendo con la misma pasión del primer día, cuidando cada detalle para que tu experiencia sea inolvidable.' },
]

const marquee = ['SABORES DE LA AMAZONÍA', 'Frescura de la selva en tu mesa']
---

<BaseLayout
  title="Nosotros | FRESCOLITO RESTAURANTE"
  description="Conoce la historia de Frescolito, cocina regional peruana en Iquitos. Más de una década sirviendo lo mejor de la Amazonía."
  effect="fade"
>
  <main style="padding-top:70px">
    <!-- 1. Intro / legado (banner) -->
    <section class="nst-intro-banner">
      <img class="nst-intro-bg" src="/imagenes/galeria/Historia.webp" alt="La historia de Frescolito" loading="eager" />
      <div class="nst-intro-overlay"></div>
      <div class="container nst-intro-content" data-reveal>
        <span class="nst-label">Desde 2014</span>
        <h1 class="nst-title">Nuestro legado</h1>
        <p>
          Desde 2014, Frescolito nació en el corazón de Iquitos con una idea sencilla: compartir lo mejor
          de la cocina amazónica y marina, preparada al momento y con ingredientes frescos de la región.
          Más de una década después, seguimos sirviendo con la misma sazón, el mismo cariño y el mismo
          compromiso de siempre.
        </p>
      </div>
    </section>

    <!-- 2. Propósito -->
    <section class="nst-proposito">
      <div class="container nst-grid">
        <div class="nst-img" data-reveal-left>
          <img class="nst-parallax" src="/imagenes/galeria/Cilindro.webp" alt="Cocina Frescolito" />
        </div>
        <div class="nst-text" data-reveal-right>
          <span class="nst-label">Lo que nos mueve</span>
          <h2 class="nst-h2">Nuestro propósito</h2>
          <p>
            Queremos ser un referente de la buena comida en la Amazonía peruana, manteniendo la calidad de
            nuestros platos, un servicio cercano y un ambiente cálido donde cada visitante se sienta como en casa.
          </p>
          <p>
            Cuidamos cada detalle, desde la selección de los insumos hasta la presentación de cada plato,
            porque creemos que comer bien es una experiencia que se comparte.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Misión / Visión -->
    <section class="nst-mv">
      <div class="container">
        <div class="nst-mv-head" data-reveal>
          <span class="nst-label">Lo que nos guía</span>
          <h2 class="nst-h2">Misión y visión</h2>
        </div>
        <div class="nst-mv-grid">
          <article class="nst-mv-card nst-mv-card--mision">
            <span class="nst-mv-num" aria-hidden="true">01</span>
            <span class="nst-mv-kicker">Misión</span>
            <h3>Lo que hacemos cada día</h3>
            <p>
              Ofrecer platos frescos y sabrosos de la cocina amazónica y marina, preparados al momento con
              ingredientes de la región, brindando un servicio atento y una experiencia acogedora a cada cliente.
            </p>
          </article>
          <article class="nst-mv-card nst-mv-card--vision">
            <span class="nst-mv-num" aria-hidden="true">02</span>
            <span class="nst-mv-kicker">Visión</span>
            <h3>Hacia dónde queremos llegar</h3>
            <p>
              Ser reconocidos como el restaurante favorito de Iquitos y un referente de la gastronomía amazónica
              del Perú, destacados por nuestra sazón, nuestra calidad y el trato familiar que nos caracteriza.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. Marquee -->
    <section class="nst-marquee" aria-hidden="true">
      <div class="nst-marquee-track">
        {[0, 1].map((k) => (
          <div class="nst-marquee-group" key={k}>
            {marquee.map((t, i) => (
              <span class="nst-marquee-item" key={i}>
                <span class="nst-marquee-text">{t}</span>
                <span class="nst-marquee-dot"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Historia -->
    <section class="nst-historia">
      <div class="container">
        <div class="nst-head" data-reveal>
          <span class="nst-label">Nuestra trayectoria</span>
          <h2 class="nst-h2">Nuestra historia</h2>
        </div>
        <div class="nst-timeline">
          {historia.map((h, i) => (
            <article class={`nst-tl-item ${i % 2 === 0 ? 'nst-tl-left' : 'nst-tl-right'}`}>
              <span class="nst-year">{h.year}</span>
              <span class="nst-tl-dot" aria-hidden="true"></span>
              <p>{h.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Visítanos -->
    <section class="nst-visitanos">
      <div class="container nst-visit-grid">
        <div class="nst-visit-info" data-reveal-left>
          <span class="nst-label">Te esperamos</span>
          <h2 class="nst-h2">Visítanos</h2>
          <p class="nst-visit-line"><strong>Iquitos, Perú</strong></p>
          <p class="nst-visit-line">Horario: <HorarioTexto client:idle /></p>
          <div class="nst-visit-actions">
            <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20Frescolito%2C%20quisiera%20hacer%20un%20pedido`} target="_blank" rel="noopener" class="btn btn-primary">
              Pedir por WhatsApp
            </a>
            <a href="/catering" class="btn btn-outline">Eventos y catering</a>
          </div>
        </div>
        <div class="nst-visit-map" data-reveal-right>
          <iframe
            src="https://www.google.com/maps?q=-3.7621462,-73.2700371&z=16&output=embed"
            width="100%"
            height="100%"
            style="border:0"
            allowFullScreen
            loading="lazy"
            referrerPolicy="no-referrer-when-downgrade"
            title="Ubicación Frescolito Restaurante"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ===== Base ===== */
  .nst-label {
    display: inline-block; font-family: var(--font-body);
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.22em; color: var(--color-primary-hover);
    margin-bottom: var(--space-sm);
  }
  .nst-title {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--color-dark); line-height: 1.05;
    margin-bottom: var(--space-md);
  }
  .nst-h2 {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--color-dark); line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  /* ===== 1. Intro (banner) ===== */
  .nst-intro-banner {
    position: relative; min-height: 66vh;
    display: grid; align-items: center; overflow: hidden;
  }
  .nst-intro-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .nst-intro-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(62,39,35,0.55) 0%, rgba(62,39,35,0.78) 100%);
  }
  .nst-intro-content {
    position: relative; z-index: 2; max-width: 720px; margin: 0 auto;
    text-align: center; padding: var(--space-xl) var(--space-md);
  }
  .nst-intro-content .nst-label { color: var(--color-primary); }
  .nst-intro-content .nst-title { color: #fff; }
  .nst-intro-content p { color: rgba(255,255,255,0.92); line-height: 1.9; font-size: 1.05rem; }

  /* ===== 2. Propósito ===== */
  .nst-proposito { padding: var(--space-xl) 0; background: #FBF6EE; }
  .nst-grid {
    display: grid; grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-xl); align-items: center;
  }
  .nst-img {
    border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-lg); aspect-ratio: 4 / 3; position: relative;
  }
  .nst-img img { position: absolute; top: -8%; left: 0; width: 100%; height: 116%; object-fit: cover; }
  .nst-text p { color: var(--color-mid); line-height: 1.9; margin-bottom: var(--space-md); }

  /* ===== 3. Misión / Visión ===== */
  .nst-mv { padding: var(--space-xl) 0; }
  .nst-mv-head {
    max-width: 640px; margin: 0 auto var(--space-xl); text-align: center;
  }
  .nst-mv-grid {
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
  }
  .nst-mv-card { position: relative; }
  .nst-mv-card--mision {
    padding-top: var(--space-md);
    border-top: 3px solid var(--color-primary);
  }
  .nst-mv-card--vision {
    background: var(--color-dark); color: #fff;
    border-radius: calc(var(--radius) + 6px);
    padding: var(--space-xl);
    box-shadow: var(--shadow-lg); overflow: hidden;
  }
  .nst-mv-num {
    position: absolute; top: 0; right: 0;
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(4rem, 8vw, 6.5rem); line-height: 1;
    color: var(--color-primary); opacity: 0.14;
    pointer-events: none; user-select: none;
  }
  .nst-mv-card--vision .nst-mv-num {
    top: var(--space-sm); right: var(--space-lg); opacity: 0.22;
  }
  .nst-mv-kicker {
    display: inline-block; font-family: var(--font-body);
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.24em; color: var(--color-primary-hover);
    margin-bottom: var(--space-sm);
  }
  .nst-mv-card--vision .nst-mv-kicker { color: var(--color-primary); }
  .nst-mv-card h3 {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(1.7rem, 2.8vw, 2.35rem); line-height: 1.15;
    color: var(--color-dark); margin-bottom: var(--space-sm);
    max-width: 18ch;
  }
  .nst-mv-card--vision h3 { color: #fff; }
  .nst-mv-card p {
    color: var(--color-mid); line-height: 1.85; font-size: 0.98rem;
    max-width: 46ch; margin: 0;
  }
  .nst-mv-card--vision p { color: rgba(255, 255, 255, 0.82); }

  /* ===== 4. Marquee ===== */
  .nst-marquee {
    overflow: hidden; background: var(--color-dark);
    padding: 1.1rem 0; border-top: 3px solid var(--color-primary);
    border-bottom: 3px solid var(--color-primary);
  }
  .nst-marquee-track { display: flex; width: max-content; animation: nst-marquee 28s linear infinite; }
  .nst-marquee-group { display: flex; align-items: center; }
  .nst-marquee-item { display: inline-flex; align-items: center; }
  .nst-marquee-text {
    font-family: var(--font-heading); font-weight: 700; font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 1.75rem); color: var(--color-bg);
    white-space: nowrap; padding: 0 1.25rem;
  }
  .nst-marquee-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-primary); flex-shrink: 0;
  }
  @keyframes nst-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nst-marquee-track { animation: none; }
  }

  /* ===== 5. Historia: línea de tiempo editorial ===== */
  .nst-historia { padding: var(--space-xl) 0; background: #FBF6EE; }
  .nst-head { text-align: center; margin-bottom: var(--space-xl); }
  .nst-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-sm) 0;
  }
  .nst-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(62, 39, 35, 0.22) 6%,
      rgba(62, 39, 35, 0.22) 94%,
      transparent 100%);
  }
  .nst-tl-item {
    position: relative;
    width: calc(50% - var(--space-lg));
    padding: 0 var(--space-lg) var(--space-md);
  }
  .nst-tl-left { align-self: flex-start; text-align: right; }
  .nst-tl-right { align-self: flex-end; text-align: left; }
  .nst-year {
    display: block;
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(2.3rem, 4vw, 3.1rem);
    color: var(--color-primary-hover);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .nst-tl-dot {
    position: absolute;
    top: 0.85rem;
    width: 13px;
    height: 13px;
    border: 3px solid var(--color-primary);
    border-radius: 50%;
    background: #FBF6EE;
    box-shadow: 0 0 0 4px #FBF6EE;
  }
  .nst-tl-left .nst-tl-dot { right: calc(-1 * var(--space-lg) - 6px); }
  .nst-tl-right .nst-tl-dot { left: calc(-1 * var(--space-lg) - 6px); }
  .nst-tl-item p {
    color: var(--color-mid);
    line-height: 1.85;
    font-size: 0.98rem;
    max-width: 38ch;
  }
  .nst-tl-left p { margin-left: auto; }
  .nst-tl-item:last-child .nst-year { color: var(--color-dark); }

  /* ===== 6. Visítanos ===== */
  .nst-visitanos { padding: var(--space-xl) 0; }
  .nst-visit-grid {
    display: grid; grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-xl); align-items: center;
  }
  .nst-visit-line { color: var(--color-mid); line-height: 2; font-size: 1.05rem; }
  .nst-visit-actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-md); }
  .nst-visit-map {
    border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-lg); height: 360px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 860px) {
    .nst-grid, .nst-visit-grid, .nst-mv-grid {
      grid-template-columns: 1fr;
    }
    .nst-grid .nst-img { order: 2; }
    .nst-grid .nst-text { order: 1; }
    .nst-mv-card--vision { padding: var(--space-lg); }
    .nst-mv-num { font-size: 4.5rem; }
    .nst-timeline::before { left: 7px; transform: none; }
    .nst-tl-item {
      width: 100%;
      align-self: stretch;
      padding: 0 0 var(--space-lg) 2.1rem;
      text-align: left;
    }
    .nst-tl-left p, .nst-tl-right p { margin-left: 0; }
    .nst-tl-left .nst-tl-dot,
    .nst-tl-right .nst-tl-dot { left: 1px; right: auto; top: 0.8rem; }
    .nst-visit-map { height: 300px; }
  }
</style>
