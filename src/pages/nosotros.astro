---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Nosotros | FRESCOLITO RESTAURANTE" description="Conoce la historia de FRESCOLITO, cocina regional peruana en Iquitos.">
  <main style="padding-top: 70px">
    <section class="na-section na-about" data-reveal>
      <div class="container na-grid">
        <div class="na-img-wrap" data-reveal-left>
          <div class="na-img-frame">
            <img src="/imagenes/galeria/EQUIPO.jpeg" alt="Equipo FRESCOLITO" loading="eager" />
          </div>
        </div>
        <div class="na-text">
          <span class="na-label">Sobre FRESCOLITO</span>
          <h2>Nuestra Historia</h2>
          <p>FRESCOLITO nació en Iquitos, en el corazón de la Amazonía peruana, con la visión de compartir los sabores auténticos de nuestra región. Cada plato es una celebración de la riqueza gastronómica de la selva peruana.</p>
          <p>Utilizamos ingredientes frescos y recetas tradicionales transmitidas de generación en generación, combinando técnicas clásicas con un toque moderno.</p>
        </div>
      </div>
    </section>

    <div class="na-wave"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,0 C200,40 500,10 800,35 C1000,50 1100,15 1200,20 L1200,60 L0,60 Z" fill="var(--color-light)" opacity="0.5"/><path d="M0,10 C300,50 700,0 1200,30 L1200,60 L0,60 Z" fill="var(--color-light)"/></svg></div>

    <section class="na-section na-history" data-reveal>
      <div class="na-history-text">
        <span class="na-label">Nuestra trayectoria</span>
        <h2>El comienzo de FRESCOLITO</h2>
        <p>FRESCOLITO comenzó como un sueño familiar en Iquitos, con la misión de llevar los auténticos sabores amazónicos a cada mesa. Desde nuestros inicios, nos comprometimos a usar ingredientes frescos de la región y recetas tradicionales que honran la rica herencia culinaria de la Amazonía peruana.</p>
        <p>Hoy, seguimos sirviendo con la misma pasión y dedicación, ofreciendo una experiencia gastronómica única en la selva peruana.</p>
      </div>
      <div class="na-history-img" data-reveal-right>
        <div class="na-img-frame na-img-frame-lg">
          <img src="/imagenes/galeria/MesaRepresentativa.png" alt="Ambiente FRESCOLITO" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="na-stats" data-reveal>
      <div class="container na-stats-grid">
        <div class="na-stat"><span class="na-stat-num" data-count-up="18">0</span><span class="na-stat-lbl">Platos en carta</span></div>
        <div class="na-stat"><span class="na-stat-num">📍</span><span class="na-stat-lbl">Iquitos, Perú</span></div>
        <div class="na-stat"><span class="na-stat-num">⭐</span><span class="na-stat-lbl">Cocina Regional</span></div>
      </div>
    </section>

    <section class="na-section na-values" data-reveal>
      <div class="container">
        <h2 class="na-sttl">Nuestros Valores</h2>
        <div class="na-vgrid">
          <div class="na-vcard"><div class="na-vicon">🍲</div><h3>Tradición</h3><p>Respetamos las recetas ancestrales de la Amazonía peruana.</p></div>
          <div class="na-vcard"><div class="na-vicon">🐟</div><h3>Frescura</h3><p>Seleccionamos los ingredientes más frescos para cada plato.</p></div>
          <div class="na-vcard"><div class="na-vicon">⭐</div><h3>Calidad</h3><p>Cada plato es preparado con los más altos estándares.</p></div>
          <div class="na-vcard"><div class="na-vicon">❤️</div><h3>Pasión</h3><p>Amamos lo que hacemos y se refleja en cada bocado.</p></div>
        </div>
      </div>
    </section>

    <section class="na-cta" data-reveal>
      <div class="container" style="text-align:center">
        <h2>Descubre nuestros platos</h2>
        <p class="na-cta-txt">Ven y disfruta de los sabores auténticos de la Amazonía peruana.</p>
        <a href="/menu" class="btn btn-primary" style="padding:1rem 2.5rem;font-size:1.05rem">Ver Menú</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .na-label {
    display:inline-block; font-size:.8rem; font-weight:700;
    text-transform:uppercase; letter-spacing:2px;
    color:var(--color-primary-hover); margin-bottom:var(--space-sm);
  }
  .na-section { padding:var(--space-xl) 0; }

  /* ABOUT */
  .na-grid {
    display:grid; grid-template-columns:1fr 1fr;
    gap:var(--space-xl); align-items:center;
  }
  .na-text h2 { margin-bottom:var(--space-md); }
  .na-text p { color:var(--color-mid); line-height:1.8; margin-bottom:var(--space-md); }

  /* IMAGE FRAME */
  .na-img-wrap { perspective:1000px; }
  .na-img-frame {
    border-radius:var(--radius); overflow:hidden;
    box-shadow:0 8px 30px rgba(0,0,0,0.1);
    transform:rotateY(-2deg) rotateX(1deg);
    transition:transform 0.6s cubic-bezier(.25,.46,.45,.94), box-shadow 0.6s ease;
    position:relative;
  }
  .na-img-frame::after {
    content:''; position:absolute; inset:0;
    border-radius:var(--radius);
    background:linear-gradient(135deg, transparent 40%, rgba(253,185,19,0.06));
    pointer-events:none;
  }
  .na-img-frame:hover {
    transform:rotateY(0deg) rotateX(0deg);
    box-shadow:0 12px 40px rgba(0,0,0,0.15);
  }
  .na-img-frame img {
    width:100%; display:block;
    transition:transform 0.8s cubic-bezier(.25,.46,.45,.94);
  }
  .na-img-frame:hover img { transform:scale(1.03); }

  .na-history .na-img-frame { transform:rotateY(2deg) rotateX(1deg); }
  .na-history .na-img-frame:hover { transform:rotateY(0deg) rotateX(0deg); }

  /* WAVE */
  .na-wave { line-height:0; }
  .na-wave svg { display:block; width:100%; height:50px; }

  /* HISTORY */
  .na-history {
    display:grid; grid-template-columns:1fr 1fr; gap:var(--space-xl);
    align-items:center;
  }
  .na-history-text h2 { margin-bottom:var(--space-md); }
  .na-history-text p { color:var(--color-mid); line-height:1.8; margin-bottom:var(--space-md); }
  .na-img-frame-lg { box-shadow:0 12px 40px rgba(0,0,0,0.12); }

  /* STATS */
  .na-stats {
    padding:var(--space-xl) 0;
    background:linear-gradient(135deg, var(--color-dark) 0%, #2c1a14 50%, var(--color-dark) 100%);
    position:relative; overflow:hidden;
  }
  .na-stats::before {
    content:''; position:absolute; inset:0;
    background:radial-gradient(circle at 30% 50%, rgba(253,185,19,0.04) 0%, transparent 60%);
  }
  .na-stats-grid {
    display:grid; grid-template-columns:repeat(3,1fr);
    gap:var(--space-xl); text-align:center; position:relative; z-index:1;
  }
  .na-stat { display:flex; flex-direction:column; align-items:center; gap:.25rem; }
  .na-stat-num { font-family:var(--font-heading); font-size:2.5rem; font-weight:900; color:var(--color-primary); }
  .na-stat-lbl { font-size:.9rem; color:var(--color-light); font-weight:500; }

  /* VALUES */
  .na-sttl { text-align:center; margin-bottom:var(--space-xl); }
  .na-vgrid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px,1fr));
    gap:var(--space-lg);
  }
  .na-vcard {
    text-align:center; padding:var(--space-lg);
    background:var(--color-bg); border-radius:var(--radius);
    box-shadow:0 2px 8px rgba(0,0,0,0.04);
    transition:transform 0.3s cubic-bezier(.25,.46,.45,.94), box-shadow 0.3s ease;
    position:relative; overflow:hidden;
  }
  .na-vcard::before {
    content:''; position:absolute; left:0; top:0; bottom:0;
    width:4px; background:var(--color-primary);
    transform:scaleY(0); transition:transform 0.3s ease;
    border-radius:0 2px 2px 0;
  }
  .na-vcard:hover {
    transform:translateY(-4px);
    box-shadow:0 12px 30px rgba(0,0,0,0.08);
  }
  .na-vcard:hover::before { transform:scaleY(1); }
  .na-vicon { font-size:2.5rem; margin-bottom:var(--space-sm); }
  .na-vcard h3 { margin-bottom:var(--space-sm); }
  .na-vcard p { color:var(--color-mid); }

  /* CTA */
  .na-cta { padding:var(--space-xl) 0; background:var(--color-light); }
  .na-cta h2 { margin-bottom:var(--space-sm); }
  .na-cta-txt { color:var(--color-mid); margin-bottom:var(--space-lg); font-size:1.05rem; }

  /* REVEAL */
  [data-reveal],[data-reveal-left],[data-reveal-right],[data-reveal-scale] {
    opacity:0; transition:opacity .6s cubic-bezier(.25,.46,.45,.94), transform .6s cubic-bezier(.25,.46,.45,.94);
  }
  [data-reveal] { transform:translateY(30px); }
  [data-reveal-left] { transform:translateX(-30px); }
  [data-reveal-right] { transform:translateX(30px); }
  [data-reveal-scale] { transform:scale(.9); }
  [data-reveal].revealed,[data-reveal-left].revealed,[data-reveal-right].revealed,[data-reveal-scale].revealed {
    opacity:1; transform:translateX(0) translateY(0) scale(1);
  }

  @media(max-width:768px) {
    .na-grid,.na-history { grid-template-columns:1fr; }
    .na-stats-grid { grid-template-columns:1fr; gap:var(--space-lg); }
    .na-img-frame { transform:none; }
    .na-img-frame:hover { transform:none; }
  }
</style>
