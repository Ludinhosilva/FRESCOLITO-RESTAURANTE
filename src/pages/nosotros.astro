---
import BaseLayout from '../layouts/BaseLayout.astro'
import HorarioTexto from '../components/react/HorarioTexto.tsx'
import { WHATSAPP_NUMBER } from '../data/config.ts'

const historia = [
  { year: '2014', texto: 'Nace Frescolito en el corazón de Iquitos, con las recetas de casa y el sueño de una familia por compartir lo mejor de nuestra cocina.' },
  { year: '2016', texto: 'Ampliamos la carta y el salón. La familia de clientes creció y Frescolito se volvió un punto de encuentro en la ciudad.' },
  { year: '2019', texto: 'Renovamos la cocina y sumamos nuevos platos regionales, siempre con insumos frescos de la Amazonía.' },
  { year: '2022', texto: 'Llegamos a más hogares de Iquitos con nuestro servicio de delivery, llevando la sazón hasta la puerta de tu casa.' },
  { year: '2024', texto: 'Habilitamos el pedido en línea y modernizamos el servicio para atenderte más rápido y mejor.' },
  { year: 'Hoy', texto: 'Seguimos sirviendo con la misma pasión del primer día, cuidando cada detalle para que tu experiencia sea inolvidable.' },
]

---

<BaseLayout
  title="Nosotros | FRESCOLITO RESTAURANTE"
  description="Conoce la historia de Frescolito, cocina regional peruana en Iquitos. Más de una década sirviendo lo mejor de la Amazonía."
  effect="fade"
>
  <main class="nst-page">
    <!-- 1. Intro / legado (banner) -->
    <section class="nst-intro-banner">
      <img class="nst-intro-bg" src="/imagenes/galeria/Historia.webp" alt="La historia de Frescolito" loading="eager" />
      <div class="nst-intro-overlay"></div>
      <div class="container nst-intro-content" data-reveal>
        <span class="nst-label">Desde 2014</span>
        <h1 class="nst-title">Nuestro legado</h1>
        <p>
          Desde 2014, Frescolito nació en el corazón de Iquitos con una idea sencilla: compartir lo mejor
          de la cocina amazónica y marina, preparada al momento y con ingredientes frescos de la región.
          Más de una década después, seguimos sirviendo con la misma sazón, el mismo cariño y el mismo
          compromiso de siempre.
        </p>
      </div>
    </section>

    <!-- 2. Propósito -->
    <section class="nst-proposito">
      <div class="container nst-grid">
        <div class="nst-img" data-reveal-left>
          <img class="nst-parallax" src="/imagenes/galeria/Cilindro.webp" alt="Cocina Frescolito" />
        </div>
        <div class="nst-text" data-reveal-right>
          <span class="nst-label">Lo que nos mueve</span>
          <h2 class="nst-h2">Nuestro propósito</h2>
          <p>
            Queremos ser un referente de la buena comida en la Amazonía peruana, manteniendo la calidad de
            nuestros platos, un servicio cercano y un ambiente cálido donde cada visitante se sienta como en casa.
          </p>
          <p>
            Cuidamos cada detalle, desde la selección de los insumos hasta la presentación de cada plato,
            porque creemos que comer bien es una experiencia que se comparte.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Misión / Visión -->
    <section class="nst-mv">
      <div class="container nst-mv-grid">
        <article class="nst-mv-card">
          <h3>Misión</h3>
          <p>
            Ofrecer platos frescos y sabrosos de la cocina amazónica y marina, preparados al momento con
            ingredientes de la región, brindando un servicio atento y una experiencia acogedora a cada cliente.
          </p>
        </article>
        <article class="nst-mv-card">
          <h3>Visión</h3>
          <p>
            Ser reconocidos como el restaurante favorito de Iquitos y un referente de la gastronomía amazónica
            del Perú, destacados por nuestra sazón, nuestra calidad y el trato familiar que nos caracteriza.
          </p>
        </article>
      </div>
    </section>

    <!-- 4. Historia -->
    <section class="nst-historia">
      <div class="container">
        <div class="nst-head" data-reveal>
          <span class="nst-label">Nuestra trayectoria</span>
          <h2 class="nst-h2">Nuestra historia</h2>
        </div>
        <div class="nst-timeline">
          {historia.map((h) => (
            <article class="nst-tl-item">
              <span class="nst-year">{h.year}</span>
              <p>{h.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Visítanos -->
    <section class="nst-visitanos">
      <div class="container nst-visit-grid">
        <div class="nst-visit-info" data-reveal-left>
          <span class="nst-label">Te esperamos</span>
          <h2 class="nst-h2">Visítanos</h2>
          <p class="nst-visit-line"><strong>Iquitos, Perú</strong></p>
          <p class="nst-visit-line">Horario: <HorarioTexto client:idle /></p>
          <div class="nst-visit-actions">
            <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20Frescolito%2C%20quisiera%20hacer%20un%20pedido`} target="_blank" rel="noopener" class="btn btn-primary">
              Pedir por WhatsApp
            </a>
            <a href="/catering" class="btn btn-outline">Eventos y catering</a>
          </div>
        </div>
        <div class="nst-visit-map" data-reveal-right>
          <iframe
            src="https://www.google.com/maps?q=-3.7621462,-73.2700371&z=16&output=embed"
            width="100%"
            height="100%"
            style="border:0"
            allowFullScreen
            loading="lazy"
            referrerPolicy="no-referrer-when-downgrade"
            title="Ubicación Frescolito Restaurante"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .nst-page { padding-top: 68px; }

  /* ===== Base ===== */
  .nst-label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-forest);
    margin-bottom: 0.6rem;
  }
  .nst-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.8rem, 5.6vw, 4.4rem);
    color: var(--color-dark);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .nst-h2 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    color: var(--color-dark);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  /* ===== 1. Intro (banner) ===== */
  .nst-intro-banner {
    position: relative;
    min-height: 58vh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  .nst-intro-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nst-intro-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 20, 17, 0.82) 0%, rgba(26, 20, 17, 0.52) 52%, rgba(26, 20, 17, 0.2) 100%),
      linear-gradient(0deg, rgba(26, 20, 17, 0.4), transparent 50%);
  }
  .nst-intro-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .nst-intro-content .nst-label { color: rgba(255, 255, 255, 0.7); }
  .nst-intro-content .nst-title { color: #fff; }
  .nst-intro-content p {
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.75;
    font-size: 1rem;
  }

  /* ===== 2. Propósito ===== */
  .nst-proposito {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-line);
  }
  .nst-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .nst-img {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-line);
  }
  .nst-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nst-text {
    max-width: 560px;
  }
  .nst-text p {
    color: var(--color-mid);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* ===== 3. Misión / Visión ===== */
  .nst-mv { padding: clamp(3rem, 6vw, 4.5rem) 0; }
  .nst-mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .nst-mv-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .nst-mv-card h3 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.45rem;
    color: var(--color-dark);
    margin-bottom: 0.6rem;
  }
  .nst-mv-card p {
    color: var(--color-mid);
    line-height: 1.8;
    font-size: 0.94rem;
  }

  /* ===== 4. Historia ===== */
  .nst-historia {
    padding: clamp(3rem, 6vw, 4.5rem) 0;
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .nst-head { margin-bottom: 2rem; }
  .nst-timeline {
    max-width: 820px;
    border-left: 1px solid var(--color-line);
  }
  .nst-tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1.5rem;
    padding: 1.15rem 0 1.15rem 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .nst-tl-item:last-child { border-bottom: 0; }
  .nst-tl-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 1.65rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .nst-year {
    display: block;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--color-forest);
    line-height: 1.6;
  }
  .nst-tl-item p {
    margin: 0;
    color: var(--color-mid);
    line-height: 1.75;
    font-size: 0.94rem;
  }

  /* ===== 5. Visítanos ===== */
  .nst-visitanos { padding: clamp(3.5rem, 7vw, 5.5rem) 0; }
  .nst-visit-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .nst-visit-line {
    color: var(--color-mid);
    line-height: 1.9;
    font-size: 0.98rem;
  }
  .nst-visit-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
  .nst-visit-map {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-line);
    height: 400px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 860px) {
    .nst-grid,
    .nst-visit-grid,
    .nst-mv-grid {
      grid-template-columns: 1fr;
    }
    .nst-grid .nst-img { order: 2; }
    .nst-grid .nst-text { order: 1; }
    .nst-tl-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .nst-tl-item::before { top: 1.55rem; }
    .nst-visit-map { height: 300px; }
  }
</style>
