---
import BaseLayout from '../layouts/BaseLayout.astro'
import MenuSection from '../components/MenuSection.astro'
---

<BaseLayout title="Menú | FRESCOLITO RESTAURANTE" description="Ceviches, chicharrones, chaufas y promociones. Descubre nuestra carta.">
  <main style="padding-top: 70px">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Nuestro Menú</h1>
        <p class="page-subtitle">Sabores auténticos de Iquitos para ti</p>
      </div>
    </section>
    <MenuSection />
  </main>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark) 0%, #1a0e0a 100%);
    text-align: center; padding: calc(70px + var(--space-xl)) 0 var(--space-lg);
  }
  .page-title { color: var(--color-primary); }
  .page-subtitle { color: var(--color-light); margin-top: var(--space-sm); }
</style>
