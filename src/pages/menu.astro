---
import BaseLayout from '../layouts/BaseLayout.astro'
import MenuPublicoIsland from '../components/react/MenuPublicoIsland.tsx'
import { listarPromociones, type Promocion } from '../lib/promociones.ts'
import '../styles/menu.css'
import '../styles/promos.css'

let promociones: Promocion[] = []
try {
  promociones = (await listarPromociones()) ?? []
} catch {
  promociones = []
}
---

<BaseLayout
  title="Menú | FRESCOLITO RESTAURANTE"
  description="Ceviches, chicharrones, chaufas y promociones. Descubre nuestra carta."
  effect="slide-up"
>
  <main class="menu-page">
    <section class="pm-header">
      <div class="container pm-frame">
        <div class="pm-copy">
          <span class="section-kicker">La carta</span>
          <h1 class="pm-title">Nuestro menú</h1>
          <p class="pm-sub">
            Cocina regional peruana con productos de la Amazonía. Ceviches,
            chicharrones, chaufas y platos preparados al momento.
          </p>
          <div class="pm-actions">
            <a href="#menu-section" class="btn btn-primary">Ver la carta</a>
            <a href="#" data-pedir class="btn btn-outline">Pedir online</a>
          </div>
          <p class="pm-note">Delivery y recojo en Iquitos · Lunes a viernes, 11:00–15:30</p>
        </div>
        <div class="pm-visual media-frame">
          <img src="/imagenes/galeria/Ceviche20.webp" alt="Ceviche de Frescolito" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>
    <MenuPublicoIsland client:visible promocionesIniciales={promociones} />
  </main>
</BaseLayout>

<style>
  .menu-page {
    padding-top: 68px;
    background: var(--color-bg);
  }

  .pm-header {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-line);
  }

  .pm-frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.9fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .pm-copy {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: 560px;
  }

  .pm-title {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.1rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
  }

  .pm-sub {
    max-width: 48ch;
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--color-mid);
  }

  .pm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.35rem;
  }

  .pm-note {
    margin: 0;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--color-mid);
  }

  .pm-visual {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 860px) {
    .pm-frame {
      grid-template-columns: 1fr;
    }
    .pm-visual {
      aspect-ratio: 16 / 10;
    }
  }
</style>
