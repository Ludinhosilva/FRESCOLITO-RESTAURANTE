---
import BaseLayout from '../layouts/BaseLayout.astro'
import MenuSection from '../components/MenuSection.astro'
---

<BaseLayout title="Menú | FRESCOLITO RESTAURANTE" description="Ceviches, chicharrones, chaufas y promociones. Descubre nuestra carta.">
  <main>
    <section class="menu-hero">
      <img src="/imagenes/carrusel/WhatsApp%20Image%202026-03-26%20at%2011.19.05%20AM.jpeg" alt="" class="menu-hero-bg" />
      <div class="menu-hero-overlay"></div>
      <div class="menu-hero-content">
        <h1 class="menu-hero-title">Nuestra Carta</h1>
        <p class="menu-hero-desc">
          FRESCOLITO es un restaurante de cocina regional peruana ubicado en Iquitos.
          Nos especializamos en ceviches, chicharrones, arroz con mariscos, chaufas
          y promociones especiales, utilizando ingredientes frescos de la Amazonía peruana.
        </p>
        <a href="javascript:window.print()" class="btn btn-secondary menu-download-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar Menú
        </a>
      </div>
    </section>
    <MenuSection />
  </main>
</BaseLayout>

<style>
  .menu-hero {
    height: 60vh; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .menu-hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .menu-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 50%);
  }
  .menu-hero-content {
    text-align: center; position: relative; z-index: 1;
    padding: 0 var(--space-md); max-width: 700px;
  }
  .menu-hero-title {
    font-family: 'Pacifico', cursive; font-weight: 400;
    color: var(--color-primary);
    -webkit-text-stroke: 3px var(--color-dark);
    paint-order: stroke fill;
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-shadow: 0 4px 16px rgba(0,0,0,0.4);
    margin-bottom: var(--space-md);
  }
  .menu-hero-desc {
    color: white; font-size: 1rem; line-height: 1.7;
    font-family: var(--font-body); font-weight: 300;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
    max-width: 600px; margin: 0 auto var(--space-md);
  }
  .menu-download-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
  }

  @media print {
    .navbar, .footer, .wa-fab, .call-fab, .cart-fab, .bh-wrapper,
    .menu-download-btn, .BusinessHours, .WhatsAppFAB, .CallButton,
    .cart-widget, .menu-add-btn, .reviews-section, .hero-scroll {
      display: none !important;
    }
    .menu-hero { height: auto; padding: 2rem 0; }
    .menu-hero-bg, .menu-hero-overlay { display: none; }
    .menu-hero-content { padding: 0; }
    .menu-hero-title { -webkit-text-stroke: 0; color: #000; font-size: 2rem; }
    .menu-hero-desc { color: #333; text-shadow: none; }
    .menu-section { padding: 1rem 0; }
    .menu-item { break-inside: avoid; }
  }

  @media (max-width: 768px) {
    .menu-hero { height: 50vh; }
    .menu-hero-title { -webkit-text-stroke: 2px var(--color-dark); }
  }
</style>
