---
import BaseLayout from '../layouts/BaseLayout.astro'
import MenuPublicoIsland from '../components/react/MenuPublicoIsland.tsx'
import { listarPromociones, type Promocion } from '../lib/promociones.ts'
import '../styles/menu.css'
import '../styles/promos.css'

let promociones: Promocion[] = []
try {
  promociones = (await listarPromociones()) ?? []
} catch {
  promociones = []
}
---

<BaseLayout title="Menú | FRESCOLITO RESTAURANTE" description="Ceviches, chicharrones, chaufas y promociones. Descubre nuestra carta." effect="slide-up">
  <main class="menu-page">
    <section class="pm-header">
      <div class="container">
        <div class="pm-frame glass">
          <div class="pm-copy">
            <span class="pm-label">· Descubre ·</span>
            <h1 class="pm-title">Nuestro Menú</h1>
            <span class="pm-divider"></span>
            <p class="pm-sub">Sabores auténticos de la Amazonía peruana</p>
            <div class="pm-actions">
              <a href="#menu-section" class="btn btn-primary pm-cta">Ver la carta</a>
              <a href="#" data-pedir class="btn btn-outline pm-cta">Pedir online</a>
            </div>
            <p class="pm-note">Delivery y recojo en Iquitos · Preparado al momento</p>
          </div>
          <div class="pm-visual" aria-hidden="true">
            <img src="/imagenes/galeria/Ceviche20.webp" alt="" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
    <MenuPublicoIsland client:visible promocionesIniciales={promociones} />
  </main>
</BaseLayout>

<style>
  .menu-page {
    padding-top: 70px;
    background: #FFFDF8;
  }

  .pm-header {
    position: relative;
    overflow: hidden;
    padding: 2.25rem 0 2.75rem;
    background:
      radial-gradient(circle at 82% 16%, rgba(253, 185, 19, 0.22), transparent 42%),
      radial-gradient(circle at 8% 92%, rgba(188, 170, 164, 0.18), transparent 40%),
      linear-gradient(180deg, #FFFDF8 0%, #FFF6E2 62%, #FFFDF8 100%);
  }
  .pm-header::before {
    content: '';
    position: absolute;
    width: 420px;
    height: 420px;
    top: -210px;
    right: -70px;
    border-radius: 50%;
    background: rgba(253, 185, 19, 0.16);
    filter: blur(80px);
    pointer-events: none;
  }

  .pm-frame {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(240px, 0.85fr);
    align-items: center;
    gap: 2rem;
    padding: 2.4rem 2.6rem;
    border-radius: 28px;
  }

  .pm-copy { max-width: 620px; }

  .pm-label {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .pm-title {
    margin: 0 0 0.8rem;
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(2.8rem, 5.4vw, 4.35rem);
    line-height: 1.05;
    color: var(--color-dark);
  }

  .pm-divider {
    display: block;
    width: 42px;
    height: 3px;
    margin-bottom: 0.95rem;
    border-radius: 3px;
    background: var(--color-primary);
  }

  .pm-sub {
    margin: 0;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-mid);
  }

  .pm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }
  .pm-cta {
    font-size: 0.86rem;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
  }

  .pm-note {
    margin: 0.9rem 0 0;
    font-family: var(--font-body);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--color-mid);
  }

  .pm-visual {
    position: relative;
    justify-self: end;
    width: min(100%, 290px);
    aspect-ratio: 1;
    padding: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(253, 185, 19, 0.34), rgba(255, 255, 255, 0.86));
    box-shadow: 0 24px 60px rgba(62, 39, 35, 0.18);
  }
  .pm-visual::after {
    content: '';
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(253, 185, 19, 0.4);
    border-radius: 50%;
    pointer-events: none;
  }
  .pm-visual img {
    width: 100%;
    height: 100%;
    border: 6px solid #fff;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 12px 30px rgba(62, 39, 35, 0.16);
  }

  @media (max-width: 900px) {
    .pm-header { padding: 1.5rem 0 2rem; }
    .pm-frame {
      grid-template-columns: 1fr;
      padding: 1.75rem;
      gap: 1rem;
    }
    .pm-visual { display: none; }
  }

  @media (max-width: 480px) {
    .pm-title { font-size: clamp(2.5rem, 12vw, 3.4rem); }
    .pm-actions { gap: 0.55rem; }
    .pm-cta { flex: 1; justify-content: center; }
  }
</style>
