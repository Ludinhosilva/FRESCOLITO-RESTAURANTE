---
import BaseLayout from '../layouts/BaseLayout.astro'
import MenuSection from '../components/MenuSection.astro'
---

<BaseLayout title="Menú | FRESCOLITO RESTAURANTE" description="Ceviches, chicharrones, chaufas y promociones. Descubre nuestra carta." effect="slide-up">
  <main style="padding-top: 70px">
    <section class="pm-header">
      <div class="container" style="text-align:center">
        <div class="pm-frame">
          <span class="pm-label">· Descubre ·</span>
          <h1 class="pm-title">Nuestro Menú</h1>
          <span class="pm-divider"></span>
          <p class="pm-sub">Sabores auténticos de la Amazonía peruana</p>
        </div>
      </div>
    </section>
    <MenuSection />
  </main>
</BaseLayout>

<style>
  .pm-header { padding: var(--space-lg) 0 var(--space-md); }

  .pm-frame {
    position: relative;
    display: inline-block;
    padding: 2.5rem 3.5rem;
  }
  .pm-frame::before,
  .pm-frame::after {
    content: '';
    position: absolute;
    border: 3px solid var(--color-dark);
    pointer-events: none;
  }
  .pm-frame::before { inset: 0; }
  .pm-frame::after {
    inset: -7px 0 0 -7px;
    opacity: 0.25;
  }
  @media (max-width: 480px) {
    .pm-frame { padding: 1.5rem 1.25rem; }
  }

  .pm-label {
    font-family: var(--font-body); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-mid); margin-bottom: var(--space-xs);
    display: block;
  }
  .pm-title {
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-dark);
    background: linear-gradient(90deg,
      var(--color-dark) 0%, var(--color-dark) 20%,
      var(--color-primary-hover) 50%, var(--color-dark) 80%,
      var(--color-dark) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: pm-shine 6s ease-in-out infinite;
    margin-bottom: var(--space-sm);
  }
  @keyframes pm-shine {
    from { background-position: 200% center; }
    to { background-position: -200% center; }
  }
  .pm-divider {
    display: block; width: 30px; height: 2px;
    background: var(--color-primary); border-radius: 2px;
    margin: 0 auto var(--space-sm);
  }
  .pm-sub {
    font-family: var(--font-body); font-size: 0.9rem;
    color: var(--color-mid); margin: 0;
  }
</style>

