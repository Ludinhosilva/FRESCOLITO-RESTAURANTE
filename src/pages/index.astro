---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import DestacadosIsland from '../components/react/DestacadosIsland.tsx'
import PromoBanner from '../components/react/PromoBanner.tsx'
import { listarDestacados } from '../lib/pedidosCliente.ts'
import { listarPromociones, type Promocion } from '../lib/promociones.ts'
import '../styles/home.css'
import '../styles/promos.css'

// Precarga en build los platos destacados reales para que el primer pintado
// ya muestre lo que hay en el panel admin (sin salto al hidratar).
let destacados = []
try {
  destacados = (await listarDestacados()) ?? []
} catch {
  destacados = []
}

let promociones: Promocion[] = []
try {
  promociones = (await listarPromociones()) ?? []
} catch {
  promociones = []
}

const puntos = [
  { title: 'Insumos frescos', text: 'Pescado y productos de la región, elegidos cada día.' },
  { title: 'Preparado al momento', text: 'Cada plato se cocina cuando lo pides, no antes.' },
  { title: 'Delivery y recojo', text: 'Llegamos a tu casa u oficina en Iquitos.' },
]
---

<BaseLayout
  title="FRESCOLITO RESTAURANTE | Iquitos - Perú"
  description="Cocina regional peruana en Iquitos. Ceviches, chicharrones, arroz con mariscos y promociones. Pide online o visítanos."
  effect="stripes"
>
  <Hero />

  <!-- Platos destacados -->
  <section class="home-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="section-kicker">Lo más pedido</span>
        <h2 class="section-title">Los favoritos de la casa</h2>
        <p class="section-lead">
          Platos que nuestros clientes vuelven a pedir: ceviches, chicharrones
          y clásicos de la carta preparados al momento.
        </p>
      </div>
      <DestacadosIsland client:visible inicial={destacados} />
      <div class="home-cta">
        <a href="/menu" class="btn btn-outline">Ver la carta completa</a>
      </div>
    </div>
  </section>

  <!-- Historia breve -->
  <section class="home-section home-section--alt">
    <div class="container home-story">
      <div class="home-story-media media-frame" data-reveal-left>
        <img src="/imagenes/galeria/Cilindro.webp" alt="Cocina de Frescolito en Iquitos" loading="lazy" />
      </div>
      <div class="home-story-copy" data-reveal-right>
        <span class="section-kicker">Desde 2014</span>
        <h2 class="section-title">Cocina de casa, en el corazón de Iquitos</h2>
        <p class="section-lead">
          Nacimos con las recetas de la familia y la idea de compartir lo mejor
          de la cocina amazónica y marina. Más de una década después, seguimos
          cocinando con el mismo cariño y los mismos insumos frescos.
        </p>
        <p class="home-story-sign">Frescolito · Calle Jesús de Nazaret A184</p>
        <a href="/nosotros" class="btn btn-outline">Conoce nuestra historia</a>
      </div>
    </div>
  </section>

  <!-- Lo que cuidamos -->
  <section class="home-section">
    <div class="container">
      <div class="home-facts">
        {puntos.map((p, i) => (
          <article class="home-fact" data-reveal style={`--i:${i}`}>
            <span class="home-fact-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Promoción destacada (banner intermedio) -->
  <section class="home-section promo-banner-section">
    <div class="container">
      <PromoBanner client:idle inicial={promociones} />
    </div>
  </section>

  <!-- Eventos / Catering -->
  <section class="home-section home-section--alt">
    <div class="container home-eventos" data-reveal>
      <div class="home-eventos-img media-frame">
        <img src="/imagenes/galeria/MesaRepresentativa.webp" alt="Servicio de catering para eventos" loading="lazy" />
      </div>
      <div class="home-eventos-text">
        <span class="section-kicker">Eventos y catering</span>
        <h2 class="section-title">Llevamos Frescolito a tu celebración</h2>
        <p class="section-lead">
          Comida para eventos, alquiler de menaje y personal de servicio.
          Nos encargamos de los detalles para que solo disfrutes con tus invitados.
        </p>
        <a href="/catering" class="btn btn-primary">Cotizar mi evento</a>
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="section reviews-section" id="reviews-section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="section-kicker">Opiniones</span>
        <h2 class="section-title">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="elfsight-app-cb8923b5-4bee-48d1-b32a-7f61b710d270" id="elfsight-resenas"></div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://static.elfsight.com/platform/platform.js" async></script>

<style>
  .home-section {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
  }
  .home-section--alt {
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .home-section.promo-banner-section { padding: 0; }
  .home-section.promo-banner-section:has(.promo-banner) {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .home-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .home-story {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .home-story-media {
    aspect-ratio: 5 / 4;
  }
  .home-story-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-story-copy .section-title {
    max-width: 16ch;
  }
  .home-story-sign {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forest);
  }

  .home-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line);
  }
  .home-fact {
    padding: 2rem 2rem 0.5rem 0;
    border-right: 1px solid var(--color-line);
  }
  .home-fact + .home-fact {
    padding-left: 2rem;
  }
  .home-fact:last-child {
    border-right: 0;
    padding-right: 0;
  }
  .home-fact-index {
    display: block;
    margin-bottom: 0.85rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-primary-hover);
  }
  .home-fact h3 {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-dark);
  }
  .home-fact p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-mid);
  }

  .home-eventos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .home-eventos-img {
    aspect-ratio: 4 / 3;
  }
  .home-eventos-text {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-eventos-text .section-title {
    max-width: 15ch;
  }

  .reviews-section {
    background: var(--color-bg);
    padding: clamp(3.5rem, 7vw, 5rem) 0;
  }

  @media (max-width: 900px) {
    .home-story,
    .home-eventos {
      grid-template-columns: 1fr;
    }
    .home-story-media {
      aspect-ratio: 16 / 10;
    }
    .home-story-copy .section-title,
    .home-eventos-text .section-title {
      max-width: none;
    }
    .home-facts {
      grid-template-columns: 1fr;
    }
    .home-fact,
    .home-fact + .home-fact {
      padding: 1.35rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .home-fact:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
  }
</style>

<script>
  // Evita el espacio en blanco si el widget de reseñas no carga:
  // tras unos segundos, si el widget sigue vacío, se oculta la sección.
  function colapsarResenasSiVacio() {
    const widget = document.getElementById('elfsight-resenas')
    const section = document.getElementById('reviews-section')
    if (!widget || !section) return
    const vacio = widget.children.length === 0 || widget.getBoundingClientRect().height < 40
    if (vacio) section.style.display = 'none'
  }
  window.addEventListener('load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
  document.addEventListener('astro:page-load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
</script>
