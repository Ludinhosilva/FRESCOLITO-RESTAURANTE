---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import DestacadosIsland from '../components/react/DestacadosIsland.tsx'
import { Fish, Leaf, Truck, HeartHandshake, PartyPopper } from 'lucide-react'
import '../styles/home.css'

const ventajas = [
  { Icon: Fish, title: 'Sazón amazónica', desc: 'Ceviches, chicharrones y platos marinos preparados al momento con recetas de casa.' },
  { Icon: Leaf, title: 'Ingredientes frescos', desc: 'Seleccionamos insumos frescos de la región amazónica para cada preparación.' },
  { Icon: Truck, title: 'Delivery y recojo', desc: 'Pide en línea y recibe en casa, o recoge en el local. Rápido y sin complicaciones.' },
  { Icon: HeartHandshake, title: 'Trato familiar', desc: 'Más de una década sirviendo con cariño a la familia de Iquitos.' },
]
---

<BaseLayout title="FRESCOLITO RESTAURANTE | Iquitos - Perú" description="Cocina regional peruana en Iquitos. Ceviches, chicharrones, arroz con mariscos y promociones. Pide online o visítanos." effect="stripes">
  <Hero />

  <!-- Platos destacados -->
  <section class="home-section">
    <div class="container">
      <div class="home-head" data-reveal>
        <span class="home-label">· Lo más pedido ·</span>
        <h2 class="home-h2">Platos destacados</h2>
        <span class="home-divider"></span>
      </div>
      <DestacadosIsland client:visible />
      <div class="home-cta-center">
        <a href="/menu" class="btn btn-outline">Ver todo el menú</a>
      </div>
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="home-section alt">
    <div class="container">
      <div class="home-head" data-reveal>
        <span class="home-label">· Por qué elegirnos ·</span>
        <h2 class="home-h2">La experiencia Frescolito</h2>
      </div>
      <div class="home-values">
        {ventajas.map(({ Icon, title, desc }) => (
          <article class="home-value" data-reveal>
            <div class="home-value-icon"><Icon /></div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Eventos / Catering -->
  <section class="home-section">
    <div class="container home-eventos" data-reveal>
      <div class="home-eventos-img">
        <img src="/imagenes/galeria/MesaRepresentativa.webp" alt="Servicio de catering para eventos" loading="lazy" />
      </div>
      <div class="home-eventos-text">
        <span class="home-label">· Eventos y catering ·</span>
        <h2 class="home-h2">¿Organizas un evento?</h2>
        <p>
          Llevamos Frescolito a tu celebración: comida para eventos, alquiler de menaje y
          personal de servicio. Cotiza fácil por WhatsApp.
        </p>
        <a href="/catering" class="btn btn-primary"><PartyPopper /> Cotizar mi evento</a>
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="section reviews-section" id="reviews-section">
    <div class="container">
      <h2 class="section-title">RESEÑAS</h2>
      <div class="elfsight-app-cb8923b5-4bee-48d1-b32a-7f61b710d270" id="elfsight-resenas"></div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://static.elfsight.com/platform/platform.js" async></script>

<style>
  .section-title { font-family: var(--font-heading); font-weight: 700; text-align: center; margin-bottom: var(--space-md); }
  .reviews-section { background: var(--color-bg); padding: var(--space-lg) 0; }

  .home-section { padding: var(--space-xl) 0; }
  .home-section.alt { background: #FBF6EE; }
  .home-head { text-align: center; margin-bottom: var(--space-xl); }
  .home-label {
    display: inline-block; font-family: var(--font-body); font-size: 0.72rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--color-primary-hover); margin-bottom: var(--space-xs);
  }
  .home-h2 {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem); color: var(--color-dark); margin-bottom: var(--space-sm);
  }
  .home-divider {
    display: block; width: 30px; height: 2px; background: var(--color-primary);
    border-radius: 2px; margin: 0 auto;
  }

  .home-cta-center { text-align: center; margin-top: var(--space-xl); }

  .home-values { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
  .home-value {
    background: var(--color-bg); border: 1px solid var(--color-light);
    border-radius: var(--radius); padding: var(--space-lg); box-shadow: var(--shadow-sm);
    border-top: 4px solid var(--color-primary);
  }
  .home-value-icon {
    width: 50px; height: 50px; border-radius: 14px; display: grid; place-items: center;
    background: rgba(253, 185, 19, 0.14); color: var(--color-primary-hover); margin-bottom: var(--space-md);
  }
  .home-value-icon svg { width: 25px; height: 25px; }
  .home-value h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; color: var(--color-dark); margin-bottom: 6px; }
  .home-value p { color: var(--color-mid); font-size: 0.92rem; line-height: 1.75; }

  .home-eventos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: center; }
  .home-eventos-img { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 4 / 3; }
  .home-eventos-img img { width: 100%; height: 100%; object-fit: cover; }
  .home-eventos-text p { color: var(--color-mid); line-height: 1.9; margin: var(--space-md) 0 var(--space-lg); }

  @media (max-width: 960px) {
    .home-values { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .home-values { grid-template-columns: 1fr; }
    .home-eventos { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Evita el espacio en blanco si el widget de reseñas no carga:
  // tras unos segundos, si el widget sigue vacío, se oculta la sección.
  function colapsarResenasSiVacio() {
    const widget = document.getElementById('elfsight-resenas')
    const section = document.getElementById('reviews-section')
    if (!widget || !section) return
    const vacio = widget.children.length === 0 || widget.getBoundingClientRect().height < 40
    if (vacio) section.style.display = 'none'
  }
  window.addEventListener('load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
  document.addEventListener('astro:page-load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
</script>
