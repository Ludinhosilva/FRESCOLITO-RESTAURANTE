---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import { featuredDishes } from '../data/menu'
import { reviews, googleRating } from '../data/reviews'
---

<BaseLayout title="FRESCOLITO RESTAURANTE | Iquitos - Perú">
  <Hero />

  <section class="section">
    <div class="container" data-reveal>
      <h2 class="section-title">Platos Destacados</h2>
      <div class="dish-grid">
        {featuredDishes.map((dish) => (
          <div class="dish-card" data-reveal>
            <img src={dish.image} alt={dish.name} class="dish-img" loading="lazy" />
            <div class="dish-info">
              <h3 class="dish-name">{dish.name}</h3>
              <span class="dish-price">S/ {dish.price.toFixed(2)}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="section-cta">
        <a href="/menu" class="btn btn-primary">Ver Menú Completo</a>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container" style="text-align:center">
      <h2 class="story-title" data-reveal>Nuestra Historia</h2>
      <p class="story-text" data-reveal>
        En FRESCOLITO traemos los sabores auténticos de la Amazonía peruana a tu mesa.
        Desde Iquitos, preparamos cada plato con ingredientes frescos y recetas tradicionales
        que capturan la esencia de nuestra tierra.
      </p>
      <a href="/nosotros" class="btn btn-primary" data-reveal>Conócenos</a>
    </div>
  </section>

  <section class="section promo-section">
    <div class="container" style="text-align:center">
      <h2 data-reveal>Promo Marino</h2>
      <p class="promo-text" data-reveal>Combina tus platos favoritos desde S/ 25.00</p>
      <a href="/menu" class="btn btn-primary" data-reveal>Ver Promociones</a>
    </div>
  </section>

  <section class="section reviews-section">
    <div class="container reviews-container">
      <div class="reviews-header">
        <h2 class="reviews-title">FRESCOLITO RESTAURANTE</h2>
        <p class="reviews-addr">Iquitos, Perú</p>
        <div class="reviews-rating">
          <span class="reviews-stars">★★★★★</span>
          <span class="reviews-score">{googleRating.score}</span>
          <span class="reviews-total">{googleRating.total} reseñas</span>
        </div>
      </div>

      <div class="reviews-list" id="reviews-list">
        {reviews.map((r, i) => (
          <div class="review-item" style={i > 2 ? 'display:none' : ''}>
            <div class="review-item-header">
              <p class="review-item-name">{r.name}</p>
              <div class="review-item-stars">
                {Array.from({ length: r.stars }).map(() => (
                  <span>★</span>
                ))}
              </div>
              <span class="review-item-time">{r.time}</span>
            </div>
            <p class="review-item-text">{r.text}</p>
          </div>
        ))}
      </div>

      <div class="reviews-dots" id="reviews-dots">
        <span class="dot active" data-page="0"></span>
        <span class="dot" data-page="1"></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align:center">
      <h2 class="section-title" data-reveal>Galería</h2>
      <div class="gallery-grid-preview" data-reveal>
        <img src="imagenes/WhatsApp Image 2026-03-26 at 11.19.05 AM.jpeg" alt="Plato 1" class="gallery-thumb" loading="lazy" />
        <img src="imagenes/WhatsApp Image 2026-03-26 at 11.19.52 AM.jpeg" alt="Plato 2" class="gallery-thumb" loading="lazy" />
        <img src="imagenes/WhatsApp Image 2026-03-27 at 10.31.09 AM.jpeg" alt="Plato 3" class="gallery-thumb" loading="lazy" />
        <img src="imagenes/WhatsApp Image 2026-03-27 at 10.34.41 AM.jpeg" alt="Plato 4" class="gallery-thumb" loading="lazy" />
      </div>
      <a href="/galeria" class="btn btn-primary" data-reveal>Ver Más Fotos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section-title { text-align: center; margin-bottom: var(--space-lg); }
  .dish-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
  }
  .dish-card {
    background: var(--color-bg); border-radius: var(--radius);
    overflow: hidden; box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .dish-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .dish-img { width: 100%; height: 200px; object-fit: cover; }
  .dish-info { padding: var(--space-md); }
  .dish-name { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .dish-price {
    font-family: var(--font-heading); font-size: 1.25rem;
    font-weight: 700; color: var(--color-primary-hover);
  }
  .section-cta { text-align: center; margin-top: var(--space-lg); }
  .story-section {
    background: linear-gradient(135deg, var(--color-dark) 0%, #1a0e0a 100%);
    color: var(--color-bg);
  }
  .story-title { color: var(--color-primary); margin-bottom: var(--space-md); }
  .story-text {
    color: var(--color-light); max-width: 700px;
    margin: 0 auto var(--space-lg); font-size: 1.1rem; line-height: 1.8;
  }
  .promo-section { background: var(--color-light); }
  .promo-text {
    color: var(--color-mid); margin-bottom: var(--space-lg); font-size: 1.1rem;
  }
  .gallery-grid-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md); margin-bottom: var(--space-lg);
  }
  .gallery-thumb {
    width: 100%; height: 180px; object-fit: cover;
    border-radius: var(--radius);
  }

  .reviews-section {
    background: var(--color-bg);
  }
  .reviews-container {
    max-width: 700px; text-align: center;
  }
  .reviews-header {
    margin-bottom: var(--space-xl);
  }
  .reviews-title {
    font-family: var(--font-heading); font-size: 1.4rem;
    color: var(--color-dark); margin-bottom: 0.25rem;
  }
  .reviews-addr {
    color: var(--color-mid); font-size: 0.9rem; margin-bottom: 0.5rem;
  }
  .reviews-rating {
    display: flex; align-items: center; justify-content: center;
    gap: 0.5rem; font-size: 0.95rem;
  }
  .reviews-stars {
    color: var(--color-primary); font-size: 1.1rem; letter-spacing: 2px;
  }
  .reviews-score {
    font-weight: 700; font-size: 1.3rem; font-family: var(--font-heading);
  }
  .reviews-total {
    color: var(--color-mid);
  }

  .reviews-list { text-align: left; }
  .review-item {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-light);
  }
  .review-item:last-child { border-bottom: none; }
  .review-item-header {
    display: flex; align-items: center; gap: 0.5rem;
    margin-bottom: 0.5rem; flex-wrap: wrap;
  }
  .review-item-name {
    font-weight: 700; font-size: 0.95rem; margin: 0;
  }
  .review-item-stars {
    color: var(--color-primary); font-size: 0.8rem; letter-spacing: 1px;
  }
  .review-item-time {
    color: var(--color-mid); font-size: 0.8rem; margin-left: auto;
  }
  .review-item-text {
    color: var(--color-mid); font-size: 0.95rem; line-height: 1.7;
    margin: 0;
  }

  .reviews-dots {
    display: flex; justify-content: center; gap: 0.5rem;
    margin-top: var(--space-lg);
  }
  .reviews-dots .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-light); cursor: pointer;
    transition: all 0.3s ease;
  }
  .reviews-dots .dot.active {
    background: var(--color-primary); width: 28px; border-radius: 5px;
  }
</style>

<script>
  const dots = document.querySelectorAll('#reviews-dots .dot')
  const items = document.querySelectorAll('#reviews-list .review-item')

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const page = parseInt(dot.dataset.page)
      dots.forEach(d => d.classList.remove('active'))
      dot.classList.add('active')

      const start = page * 3
      items.forEach((item, i) => {
        item.style.display = (i >= start && i < start + 3) ? '' : 'none'
      })
    })
  })
</script>
