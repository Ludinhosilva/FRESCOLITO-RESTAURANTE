---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import DestacadosIsland from '../components/react/DestacadosIsland.tsx'
import PromoBanner from '../components/react/PromoBanner.tsx'
import { Fish, Leaf, Truck, HeartHandshake, PartyPopper, ArrowRight } from 'lucide-react'
import { listarDestacados } from '../lib/pedidosCliente.ts'
import { listarPromociones, type Promocion } from '../lib/promociones.ts'
import '../styles/home.css'
import '../styles/promos.css'

// Precarga en build los platos destacados reales para que el primer pintado
// ya muestre lo que hay en el panel admin (sin salto al hidratar).
let destacados = []
try {
  destacados = (await listarDestacados()) ?? []
} catch {
  destacados = []
}

let promociones: Promocion[] = []
try {
  promociones = (await listarPromociones()) ?? []
} catch {
  promociones = []
}

const ventajas = [
  { Icon: Fish, title: 'Sazón amazónica', desc: 'Ceviches, chicharrones y platos marinos preparados al momento con recetas de casa.' },
  { Icon: Leaf, title: 'Ingredientes frescos', desc: 'Seleccionamos insumos frescos de la región amazónica para cada preparación.' },
  { Icon: Truck, title: 'Delivery y recojo', desc: 'Pide en línea y recibe en casa, o recoge en el local. Rápido y sin complicaciones.' },
  { Icon: HeartHandshake, title: 'Trato familiar', desc: 'Más de una década sirviendo con cariño a la familia de Iquitos.' },
]
---

<BaseLayout title="FRESCOLITO RESTAURANTE | Iquitos - Perú" description="Cocina regional peruana en Iquitos. Ceviches, chicharrones, arroz con mariscos y promociones. Pide online o visítanos." effect="stripes">
  <Hero />

  <!-- Platos destacados -->
  <section class="home-section">
    <div class="container">
      <div class="home-head" data-reveal>
        <span class="home-label">· Lo más pedido ·</span>
        <h2 class="home-h2">Platos destacados</h2>
        <span class="home-divider"></span>
      </div>
      <DestacadosIsland client:visible inicial={destacados} />
      <div class="home-cta-center">
        <a href="/menu" class="btn btn-outline">Ver todo el menú</a>
      </div>
    </div>
  </section>

  <!-- Promoción destacada (banner intermedio) -->
  <section class="home-section promo-banner-section">
    <div class="container">
      <PromoBanner client:idle inicial={promociones} />
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="home-section alt">
    <div class="container home-values-layout">
      <div class="home-values-intro" data-reveal-left>
        <span class="home-label">· Por qué elegirnos ·</span>
        <h2 class="home-h2">La experiencia Frescolito</h2>
        <span class="home-values-rule" aria-hidden="true"></span>
        <p>
          Una cocina de casa, ingredientes frescos de la Amazonía y una atención cercana.
          Eso es lo que encontrarás en cada visita.
        </p>
        <a href="/nosotros" class="home-values-link">
          Conoce nuestra historia <ArrowRight />
        </a>
      </div>
      <div class="home-values">
        {ventajas.map(({ Icon, title, desc }, i) => (
          <article class="home-value" data-reveal>
            <span class="home-value-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="home-value-icon"><Icon /></div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Eventos / Catering -->
  <section class="home-section">
    <div class="container home-eventos" data-reveal>
      <div class="home-eventos-img">
        <img src="/imagenes/galeria/MesaRepresentativa.webp" alt="Servicio de catering para eventos" loading="lazy" />
      </div>
      <div class="home-eventos-text">
        <span class="home-label">· Eventos y catering ·</span>
        <h2 class="home-h2">¿Organizas un evento?</h2>
        <p>
          Llevamos Frescolito a tu celebración: comida para eventos, alquiler de menaje y
          personal de servicio. Cotiza fácil por WhatsApp.
        </p>
        <a href="/catering" class="btn btn-primary"><PartyPopper /> Cotizar mi evento</a>
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="section reviews-section" id="reviews-section">
    <div class="container">
      <h2 class="section-title">RESEÑAS</h2>
      <div class="elfsight-app-cb8923b5-4bee-48d1-b32a-7f61b710d270" id="elfsight-resenas"></div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://static.elfsight.com/platform/platform.js" async></script>

<style>
  .section-title { font-family: var(--font-heading); font-weight: 700; text-align: center; margin-bottom: var(--space-md); }
  .reviews-section { background: var(--color-bg); padding: var(--space-lg) 0; }

  .home-section { padding: var(--space-xl) 0; }
  .home-section.alt { background: #FBF6EE; }
  /* Evita el hueco cuando no hay promociones o el banner se cierra. */
  .home-section.promo-banner-section { padding: 0; }
  .home-section.promo-banner-section:has(.promo-banner) { padding: var(--space-xl) 0; }
  .home-head { text-align: center; margin-bottom: var(--space-xl); }
  .home-label {
    display: inline-block; font-family: var(--font-body); font-size: 0.72rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--color-primary-hover); margin-bottom: var(--space-xs);
  }
  .home-h2 {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem); color: var(--color-dark); margin-bottom: var(--space-sm);
  }
  .home-divider {
    display: block; width: 30px; height: 2px; background: var(--color-primary);
    border-radius: 2px; margin: 0 auto;
  }

  .home-cta-center { text-align: center; margin-top: var(--space-xl); }

  .home-values-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .home-values-intro { position: sticky; top: 110px; }
  .home-values-intro .home-h2 { margin-bottom: var(--space-sm); }
  .home-values-rule {
    display: block; width: 48px; height: 3px; border-radius: 999px;
    background: var(--color-primary); margin-bottom: var(--space-md);
  }
  .home-values-intro p {
    max-width: 36ch; margin: 0 0 var(--space-md);
    color: var(--color-mid); line-height: 1.85;
  }
  .home-values-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding-bottom: 2px; border-bottom: 1px solid rgba(243, 156, 18, 0.35);
    font-family: var(--font-body); font-size: 0.88rem; font-weight: 700;
    color: var(--color-primary-hover);
  }
  .home-values-link svg { width: 16px; height: 16px; }
  .home-values {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0; border-top: 1px solid rgba(62, 39, 35, 0.14);
  }
  .home-value {
    position: relative;
    padding: var(--space-lg) var(--space-md) var(--space-lg) 0;
    border-bottom: 1px solid rgba(62, 39, 35, 0.14);
    background: transparent; border-radius: 0; box-shadow: none;
  }
  .home-value:nth-child(odd) {
    padding-right: var(--space-lg);
    border-right: 1px solid rgba(62, 39, 35, 0.14);
  }
  .home-value:nth-child(even) { padding-left: var(--space-lg); }
  .home-value-num {
    position: absolute; top: var(--space-lg); right: 0;
    font-family: var(--font-heading); font-size: 1rem; font-weight: 700;
    letter-spacing: 0.04em; color: var(--color-light);
  }
  .home-value-icon {
    display: grid; place-items: center;
    width: 44px; height: 44px; margin-bottom: var(--space-sm);
    border-radius: 50%; border: 1px solid rgba(253, 185, 19, 0.45);
    background: rgba(253, 185, 19, 0.08); color: var(--color-primary-hover);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .home-value-icon svg { width: 22px; height: 22px; }
  .home-value:hover .home-value-icon {
    background: var(--color-primary); color: var(--color-dark);
    transform: rotate(-6deg);
  }
  .home-value h3 {
    font-family: var(--font-heading); font-weight: 700; font-size: 1.2rem;
    color: var(--color-dark); margin-bottom: 6px;
  }
  .home-value p { color: var(--color-mid); font-size: 0.92rem; line-height: 1.75; }

  .home-eventos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: center; }
  .home-eventos-img { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 4 / 3; }
  .home-eventos-img img { width: 100%; height: 100%; object-fit: cover; }
  .home-eventos-text p { color: var(--color-mid); line-height: 1.9; margin: var(--space-md) 0 var(--space-lg); }

  @media (max-width: 960px) {
    .home-values-layout { grid-template-columns: 1fr; gap: var(--space-lg); }
    .home-values-intro { position: static; }
    .home-values-intro p { max-width: none; }
  }
  @media (max-width: 700px) {
    .home-values { grid-template-columns: 1fr; }
    .home-value,
    .home-value:nth-child(odd),
    .home-value:nth-child(even) {
      padding: var(--space-md) 0;
      border-right: 0;
    }
    .home-value-num { top: var(--space-md); }
    .home-eventos { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Evita el espacio en blanco si el widget de reseñas no carga:
  // tras unos segundos, si el widget sigue vacío, se oculta la sección.
  function colapsarResenasSiVacio() {
    const widget = document.getElementById('elfsight-resenas')
    const section = document.getElementById('reviews-section')
    if (!widget || !section) return
    const vacio = widget.children.length === 0 || widget.getBoundingClientRect().height < 40
    if (vacio) section.style.display = 'none'
  }
  window.addEventListener('load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
  document.addEventListener('astro:page-load', () => {
    setTimeout(colapsarResenasSiVacio, 3500)
  })
</script>
