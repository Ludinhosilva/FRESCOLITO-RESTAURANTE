---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/react/ContactForm.tsx'
---

<BaseLayout title="Contacto | FRESCOLITO RESTAURANTE" description="Contáctanos. Estamos ubicados en Iquitos, Perú." effect="slide-right">
  <main class="pc-page">
    <section class="pc-header">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">Contáctanos</span>
          <h1 class="section-title">Contacto</h1>
          <p class="section-lead">Escríbenos para pedidos, reservas o consultas. Estamos en Iquitos, Perú.</p>
        </div>
      </div>
    </section>
    <ContactForm client:load />
  </main>
</BaseLayout>

<style>
  .pc-page { padding-top: 68px; }
  .pc-header {
    padding: clamp(2.5rem, 5vw, 4rem) 0 1rem;
    border-bottom: 1px solid var(--color-line);
  }
</style>

