---
import BaseLayout from '../layouts/BaseLayout.astro'
import ReclamacionForm from '../components/react/ReclamacionForm.tsx'
---

<BaseLayout
  title="Libro de Reclamaciones | FRESCOLITO RESTAURANTE"
  description="Libro de Reclamaciones Virtual de Frescolito Restaurante."
  effect="fade"
>
  <main class="legal-page" style="padding-top:68px">
    <div class="container legal">
      <span class="legal-label">Legal</span>
      <h1 class="legal-title">Libro de Reclamaciones</h1>

      <p>
        De conformidad con el Código de Protección y Defensa del Consumidor (Ley N.º 29571) y su reglamento,
        <strong>Frescolito Restaurante</strong> pone a tu disposición su <strong>Libro de Reclamaciones Virtual</strong>.
      </p>
      <p>
        Completa el formulario para registrar tu <strong>reclamo</strong> (disconformidad con el producto o servicio)
        o <strong>queja</strong> (malestar con la atención recibida). Recibirás una constancia con tu número de registro.
      </p>

      <div class="legal-form">
        <ReclamacionForm client:load />
      </div>

      <p class="legal-note">
        También puedes escribirnos a <a href="mailto:contacto.frescolito@gmail.com">contacto.frescolito@gmail.com</a>.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .legal-page { padding-bottom: var(--space-xl); }
  .legal { max-width: 760px; padding-top: clamp(2.5rem, 5vw, 4rem); }
  .legal-label {
    display: inline-block; font-family: var(--font-body); font-size: 0.72rem;
    font-weight: 600; text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--color-forest); margin-bottom: 0.6rem;
  }
  .legal-title {
    font-family: var(--font-heading); font-style: italic; font-weight: 400;
    font-size: clamp(2.2rem, 4.5vw, 3.1rem); letter-spacing: -0.02em;
    color: var(--color-dark); margin-bottom: 1rem;
  }
  .legal p { color: var(--color-mid); line-height: 1.8; font-size: 0.94rem; margin-bottom: var(--space-md); }
  .legal a { color: var(--color-forest); font-weight: 500; }
  .legal-form { margin: var(--space-lg) 0; }
  .legal-note { font-size: 0.9rem; }
</style>
