---
import BaseLayout from '../layouts/BaseLayout.astro'
import GaleriaIsland from '../components/react/GaleriaIsland.tsx'
import '../styles/galeria.css'

const categorias = [
  { id: 'todas', label: 'Todas' },
  { id: 'platos', label: 'Platos' },
  { id: 'ambiente', label: 'Ambiente' },
  { id: 'mesa', label: 'Mesa y Presentación' },
]

const fallback = [
  { src: '/imagenes/galeria/ArrozMarisco.webp', alt: 'Arroz con Mariscos', cat: 'platos' },
  { src: '/imagenes/galeria/Ceviche20.webp', alt: 'Ceviche', cat: 'platos' },
  { src: '/imagenes/galeria/ChaufaRegional.webp', alt: 'Chaufa Regional', cat: 'platos' },
  { src: '/imagenes/galeria/Chicharron.webp', alt: 'Chicharrón', cat: 'platos' },
  { src: '/imagenes/galeria/CombinadoCc.webp', alt: 'Combinado', cat: 'platos' },
  { src: '/imagenes/galeria/CombinadoCevChau.webp', alt: 'Ceviche y Chaufa', cat: 'platos' },
  { src: '/imagenes/galeria/Lomo.webp', alt: 'Lomo Saltado', cat: 'platos' },
  { src: '/imagenes/galeria/Pescado.webp', alt: 'Pescado', cat: 'platos' },
  { src: '/imagenes/galeria/RONDA.webp', alt: 'Ronda de Platos', cat: 'platos' },
  { src: '/imagenes/galeria/Cilindro.webp', alt: 'Cocina FRESCOLITO', cat: 'ambiente' },
  { src: '/imagenes/galeria/Comidas.webp', alt: 'Preparación', cat: 'ambiente' },
  { src: '/imagenes/galeria/EQUIPO.webp', alt: 'Equipo FRESCOLITO', cat: 'ambiente' },
  { src: '/imagenes/galeria/Historia.webp', alt: 'Historia FRESCOLITO', cat: 'ambiente' },
  { src: '/imagenes/galeria/Plancha.webp', alt: 'Cocina a la Plancha', cat: 'ambiente' },
  { src: '/imagenes/galeria/Presentacion.webp', alt: 'Presentación de Platos', cat: 'ambiente' },
  { src: '/imagenes/galeria/Mesacomida.webp', alt: 'Mesa Servida', cat: 'mesa' },
  { src: '/imagenes/galeria/MesaGaleria.webp', alt: 'Galería de Mesa', cat: 'mesa' },
  { src: '/imagenes/galeria/MesaRepresentativa.webp', alt: 'Mesa Representativa', cat: 'mesa' },
]
---

<BaseLayout title="Galería | FRESCOLITO RESTAURANTE" description="Galería de fotos de nuestros platos, ambiente y momentos en FRESCOLITO." effect="scale">
  <main style="padding-top:70px">
    <section class="gal-header">
      <div class="container" style="text-align:center">
        <span class="gal-label">· Explora ·</span>
        <h1 class="gal-title">Galería</h1>
        <span class="gal-divider"></span>
        <p class="gal-sub">Descubre nuestros platos, ambiente y momentos</p>
      </div>
    </section>

    <section class="gal-section">
      <div class="container">
        <GaleriaIsland client:visible tabla="galeria" categorias={categorias} fallback={fallback} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .gal-header { padding: var(--space-lg) 0 var(--space-md); }
  .gal-label {
    font-family: var(--font-body); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-mid); margin-bottom: var(--space-xs);
    display: block;
  }
  .gal-title {
    font-family: var(--font-script); font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-dark);
    background: linear-gradient(90deg,
      var(--color-dark) 0%, var(--color-dark) 20%,
      var(--color-primary-hover) 50%, var(--color-dark) 80%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gal-shine 6s ease-in-out infinite;
    margin-bottom: var(--space-sm);
  }
  @keyframes gal-shine {
    from { background-position: 200% center; }
    to { background-position: -200% center; }
  }
  .gal-divider {
    display: block; width: 30px; height: 2px;
    background: var(--color-primary); border-radius: 2px;
    margin: 0 auto var(--space-sm);
  }
  .gal-sub {
    font-family: var(--font-body); font-size: 0.9rem;
    color: var(--color-mid); margin: 0;
  }

  .gal-section { padding: 0 0 var(--space-xl); }
</style>
