---
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import BusinessHours from '../components/BusinessHours.astro'
import CartWidget from '../components/CartWidget.astro'
import WhatsAppFAB from '../components/WhatsAppFAB.astro'
import CartDrawer from '../components/react/CartDrawer.jsx'
import { GOOGLE_MAPS_URL } from '../data/config'
import '../styles/global.css'
import Preloader from '../components/Preloader.astro'

export interface Props {
  title?: string
  description?: string
}

const { title = 'FRESCOLITO RESTAURANTE', description = 'Cocina regional peruana en Iquitos' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/imagenes/frescolito.jpeg" />
    <link rel="icon" href="/imagenes/frescolito.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Playfair+Display:wght@400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "@id": "https://frescolito-restaurante.vercel.app",
        "name": "FRESCOLITO RESTAURANTE",
        "description": "Cocina regional peruana en Iquitos. Ceviches, chicharrones, arroz con mariscos y más.",
        "image": "/imagenes/frescolito.jpeg",
        "url": "https://frescolito-restaurante.vercel.app",
        "telephone": "+51927367844",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Iquitos",
          "addressCountry": "PE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -3.7621462,
          "longitude": -73.2700371
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "11:30",
          "closes": "15:15"
        },
        "servesCuisine": "Peruvian",
        "priceRange": "S/10 - S/40",
        "menu": "https://frescolito-restaurante.vercel.app/menu"
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Preloader />
    <Navbar />
    <slot />
    <BusinessHours />
    <WhatsAppFAB />
    <CartWidget />
    <CartDrawer client:load />
    <Footer />
  </body>
</html>

<script>
  import Lenis from 'lenis'
  import initScrollReveal from '../utils/scrollReveal'

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    wheelMultiplier: 1,
    touchMultiplier: 1.5,
  })

  function raf(time) {
    lenis.raf(time)
    requestAnimationFrame(raf)
  }

  requestAnimationFrame(raf)

  document.addEventListener('astro:page-load', initScrollReveal)
  initScrollReveal()
</script>
