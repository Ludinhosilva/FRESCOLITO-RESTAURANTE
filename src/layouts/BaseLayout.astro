---
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import BusinessHours from '../components/BusinessHours.astro'
import WhatsAppFAB from '../components/WhatsAppFAB.astro'
import CallButton from '../components/CallButton.astro'
import CartDrawer from '../components/react/CartDrawer.jsx'
import { GOOGLE_MAPS_URL } from '../data/config'
import '../styles/global.css'

export interface Props {
  title?: string
  description?: string
}

const { title = 'FRESCOLITO RESTAURANTE', description = 'Cocina regional peruana en Iquitos' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/imagenes/frescolito.jpeg" />
    <link rel="icon" href="/imagenes/frescolito.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Playfair+Display:wght@400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "@id": "https://frescolito-restaurante.vercel.app",
        "name": "FRESCOLITO RESTAURANTE",
        "description": "Cocina regional peruana en Iquitos. Ceviches, chicharrones, arroz con mariscos y más.",
        "image": "/imagenes/frescolito.jpeg",
        "url": "https://frescolito-restaurante.vercel.app",
        "telephone": "+51927367844",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Iquitos",
          "addressCountry": "PE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -3.7621462,
          "longitude": -73.2700371
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "11:30",
          "closes": "15:15"
        },
        "servesCuisine": "Peruvian",
        "priceRange": "S/10 - S/40",
        "menu": "https://frescolito-restaurante.vercel.app/menu"
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <slot />
    <BusinessHours />
    <WhatsAppFAB />
    <CallButton />
    <CartDrawer client:load />
    <Footer />

    <button id="dark-toggle" class="dark-toggle" aria-label="Modo oscuro">
      <span id="dark-icon">🌙</span>
    </button>
  </body>
</html>

<style>
  .dark-toggle {
    position: fixed; bottom: 80px; right: 20px; z-index: 997;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--color-bg); color: var(--color-text);
    border: 1px solid var(--color-light);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 1.2rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }
  .dark-toggle:hover {
    transform: scale(1.1);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 600px) {
    .dark-toggle { bottom: 78px; right: 20px; }
  }
</style>

<script>
  const toggle = document.getElementById('dark-toggle')
  const icon = document.getElementById('dark-icon')
  const isDark = localStorage.getItem('frescolito-dark') === 'true'
  if (isDark) { document.body.classList.add('dark-mode'); icon.textContent = '☀️' }
  toggle?.addEventListener('click', () => {
    document.body.classList.toggle('dark-mode')
    const dark = document.body.classList.contains('dark-mode')
    localStorage.setItem('frescolito-dark', dark)
    icon.textContent = dark ? '☀️' : '🌙'
  })
</script>
