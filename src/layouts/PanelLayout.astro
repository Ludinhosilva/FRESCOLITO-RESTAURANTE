---
import '../styles/panel-base.css'
const { title = 'Frescolito' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FDB913" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/jpeg" href="/imagenes/frescolito.jpeg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
