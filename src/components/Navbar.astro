---
const links = [
  { to: '/', label: 'Inicio' },
  { to: '/menu', label: 'Menú' },
  { to: '/catering', label: 'Eventos' },
  { to: '/nosotros', label: 'Nosotros' },
  { to: '/galeria', label: 'Galería' },
  { to: '/contacto', label: 'Contacto' },
]
---

<nav class="navbar" id="navbar">
  <div class="container nav-container">
    <a href="/" class="nav-logo">
      <img src="/imagenes/frescolito.jpeg" alt="FRESCOLITO" class="nav-logo-img" />
    </a>

    <button class="hamburger-btn" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>

    <div class="nav-links" id="nav-links">
      {links.map((link) => (
        <a href={link.to} class="nav-link">{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

<aside class="mobile-drawer" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú de navegación" aria-hidden="true" tabindex="-1">
  <div class="mobile-drawer-head">
    <img src="/imagenes/frescolito.jpeg" alt="FRESCOLITO" class="mobile-drawer-logo" />
    <button class="mobile-close" id="mobile-close" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <nav class="mobile-drawer-nav" aria-label="Secciones">
    {links.map((link) => (
      <a href={link.to} class="mobile-link">{link.label}</a>
    ))}
  </nav>
  <p class="mobile-drawer-foot">FRESCOLITO · Iquitos, Perú</p>
</aside>

<style>
  .navbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-navbar, 100);
    background: transparent;
    transition: background 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .navbar.scrolled {
    background: rgba(251, 248, 242, 0.94);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-line);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .navbar.scrolled { background: var(--color-bg); }
  }
  .nav-container {
    display: flex; align-items: center; justify-content: center;
    height: 68px; position: relative;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 0.5rem;
    text-decoration: none;
    position: absolute; left: 1.25rem;
  }
  .nav-logo-img {
    height: 40px; width: 40px; border-radius: 50%; object-fit: cover;
    transition: border 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .navbar.scrolled .nav-logo-img {
    border-color: var(--color-line);
  }
  .nav-links { display: flex; gap: 2rem; align-items: center; }
  .nav-link {
    font-family: var(--font-body); font-weight: 500; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    position: relative; transition: color 0.25s ease;
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .navbar:not(.scrolled) .nav-link { color: rgba(255, 255, 255, 0.92); text-shadow: 0 1px 4px rgba(0,0,0,0.3); }
  .navbar.scrolled .nav-link { color: var(--color-dark); }
  .nav-link::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 1px; background: var(--color-primary);
    transform: scaleX(0); transition: transform 0.25s ease;
  }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .navbar:not(.scrolled) .nav-link:hover { color: var(--color-primary); }
  .navbar:not(.scrolled) .nav-link:active { color: var(--color-bg); }
  .navbar.scrolled .nav-link:hover { color: var(--color-primary-hover); }
  .navbar.scrolled .nav-link:active { color: var(--color-dark); }

  .hamburger-btn {
    display: none; flex-direction: column; justify-content: center;
    align-items: center; gap: 5px; width: 44px; height: 44px;
    background: none; border: none; cursor: pointer;
    position: absolute; right: var(--space-md); z-index: 1;
  }
  .hamburger-btn span {
    display: block; width: 24px; height: 2px;
    border-radius: 2px; transition: all 0.3s ease;
  }
  .navbar:not(.scrolled) .hamburger-btn span { background: white; }
  .navbar.scrolled .hamburger-btn span { background: var(--color-dark); }
  .hamburger-btn.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger-btn.active span:nth-child(2) { opacity: 0; }
  .hamburger-btn.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ===== Drawer lateral móvil ===== */
  .mobile-backdrop {
    position: fixed; inset: 0; z-index: var(--z-overlay, 400);
    background: rgba(38, 30, 25, 0.42);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s;
  }
  .mobile-backdrop.open { opacity: 1; visibility: visible; pointer-events: auto; }

  .mobile-drawer {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: var(--z-modal, 450);
    width: min(84vw, 340px);
    display: flex; flex-direction: column;
    background: var(--color-bg);
    border-left: 1px solid var(--color-line);
    box-shadow: -12px 0 40px rgba(51, 42, 36, 0.14);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 0.35s;
    padding-bottom: env(safe-area-inset-bottom);
    visibility: hidden;
  }
  .mobile-drawer.open {
    transform: translateX(0); visibility: visible;
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), visibility 0s;
  }
  .mobile-drawer-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; border-bottom: 1px solid rgba(62, 39, 35, 0.08);
  }
  .mobile-drawer-logo {
    height: 42px; width: 42px; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--color-primary);
  }
  .mobile-close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border: none; border-radius: 12px;
    background: rgba(62, 39, 35, 0.06); color: var(--color-dark); cursor: pointer;
    transition: background 0.2s ease;
  }
  .mobile-close:hover { background: rgba(62, 39, 35, 0.12); }
  .mobile-drawer-nav {
    flex: 1; overflow-y: auto; padding: 8px 0;
    display: flex; flex-direction: column;
  }
  .mobile-link {
    display: flex; align-items: center; min-height: 52px;
    padding: 0 20px; font-family: var(--font-body);
    font-weight: 500; font-size: 0.95rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: background 0.2s ease, color 0.2s ease, padding-left 0.2s ease;
  }
  .mobile-link:hover, .mobile-link:focus-visible {
    background: var(--color-surface-alt); color: var(--color-dark);
    padding-left: 24px;
  }
  .mobile-link.active { color: var(--color-primary-hover); }
  .mobile-link.active::after {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-primary); margin-left: auto; margin-right: 4px;
  }
  .mobile-drawer-foot {
    padding: 14px 20px; font-size: 0.72rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-mid); text-align: center;
  }

  @media (max-width: 768px) {
    .hamburger-btn { display: flex; }
    .nav-links { display: none !important; }
  }
  @media (min-width: 769px) {
    .mobile-drawer, .mobile-backdrop { display: none; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar')
  const hamburger = document.getElementById('hamburger')
  const menu = document.getElementById('mobile-menu')
  const backdrop = document.getElementById('mobile-backdrop')
  const closeBtn = document.getElementById('mobile-close')
  const isHome = window.location.pathname === '/'

  function updateNav() {
    if (!navbar) return
    if (!isHome) {
      navbar.classList.add('scrolled')
      return
    }
    if (window.scrollY > window.innerHeight * 0.7) {
      navbar.classList.add('scrolled')
    } else {
      navbar.classList.remove('scrolled')
    }
  }

  updateNav()
  window.addEventListener('scroll', updateNav, { passive: true })

  function abrirMenu() {
    if (!menu || !hamburger) return
    menu.classList.add('open')
    backdrop?.classList.add('open')
    menu.setAttribute('aria-hidden', 'false')
    hamburger.classList.add('active')
    hamburger.setAttribute('aria-expanded', 'true')
    hamburger.setAttribute('aria-label', 'Cerrar menú')
    document.body.style.overflow = 'hidden'
    closeBtn?.focus()
  }
  function cerrarMenu() {
    if (!menu || !hamburger) return
    menu.classList.remove('open')
    backdrop?.classList.remove('open')
    menu.setAttribute('aria-hidden', 'true')
    hamburger.classList.remove('active')
    hamburger.setAttribute('aria-expanded', 'false')
    hamburger.setAttribute('aria-label', 'Abrir menú')
    document.body.style.overflow = ''
    hamburger.focus()
  }
  function menuAbierto() {
    return !!menu?.classList.contains('open')
  }

  if (hamburger && menu) {
    hamburger.addEventListener('click', () => {
      menuAbierto() ? cerrarMenu() : abrirMenu()
    })
    closeBtn?.addEventListener('click', cerrarMenu)
    backdrop?.addEventListener('click', cerrarMenu)

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuAbierto()) cerrarMenu()
    })

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => cerrarMenu())
    })

    const path = window.location.pathname
    document.querySelectorAll('.nav-link, .mobile-link').forEach(link => {
      if (link.getAttribute('href') === path) link.classList.add('active')
    })
  }
</script>
