---
import { BUSINESS_HOURS } from '../data/config'
---

<div id="business-hours" class="bh-wrapper">
  <div class="bh-indicator" id="bh-indicator">
    <span class="bh-dot" id="bh-dot"></span>
    <span class="bh-status" id="bh-status">Abierto</span>
  </div>
  <div class="bh-tooltip">
    <strong>Horario de Atención</strong><br/>
    {BUSINESS_HOURS.label}: {String(BUSINESS_HOURS.open.h).padStart(2,'0')}:{String(BUSINESS_HOURS.open.m).padStart(2,'0')} AM - {BUSINESS_HOURS.close.h}:{String(BUSINESS_HOURS.close.m).padStart(2,'0')} PM
  </div>
</div>

<style>
  .bh-wrapper {
    position: fixed; bottom: 20px; left: 20px; z-index: 999;
    cursor: pointer;
  }
  .bh-indicator {
    display: flex; align-items: center; gap: 8px;
    background: var(--color-bg); padding: 10px 16px;
    border-radius: 50px; box-shadow: var(--shadow-lg);
    font-family: var(--font-body); font-size: 0.85rem; font-weight: 700;
    border: 1px solid var(--color-light);
    transition: transform 0.3s ease;
  }
  .bh-indicator:hover { transform: scale(1.05); }
  .bh-dot {
    width: 10px; height: 10px; border-radius: 50%;
    flex-shrink: 0; display: inline-block;
  }
  .bh-dot.open { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.5); }
  .bh-dot.closed { background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.5); }
  .bh-tooltip {
    display: none; position: absolute; bottom: calc(100% + 10px); left: 0;
    background: var(--color-dark); color: var(--color-bg);
    padding: 12px 16px; border-radius: var(--radius);
    font-size: 0.8rem; line-height: 1.6; white-space: nowrap;
    box-shadow: var(--shadow-lg);
  }
  .bh-wrapper:hover .bh-tooltip { display: block; }
</style>

<script>
  function updateHours() {
    const dot = document.getElementById('bh-dot')
    const status = document.getElementById('bh-status')
    if (!dot || !status) return

    const now = new Date()
    const day = now.getDay()
    const minutes = now.getHours() * 60 + now.getMinutes()
    const businessDays = [1, 2, 3, 4, 5]
    const openMin = 11 * 60 + 30
    const closeMin = 15 * 60 + 15

    const isOpen = businessDays.includes(day) && minutes >= openMin && minutes < closeMin

    dot.className = 'bh-dot ' + (isOpen ? 'open' : 'closed')
    status.textContent = isOpen ? 'Abierto ahora' : 'Cerrado'
  }

  updateHours()
  setInterval(updateHours, 60000)
</script>
