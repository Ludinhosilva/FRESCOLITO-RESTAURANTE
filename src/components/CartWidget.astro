---

<div id="cart-root">
  <button id="cart-btn" class="cart-fab" aria-label="Carrito de compras" style="display:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
    </svg>
    <span id="cart-count" class="cart-badge">0</span>
  </button>
</div>

<style>
  .cart-fab {
    position: fixed; bottom: 20px; right: 20px; z-index: 999;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--color-primary); color: var(--color-dark);
    border: none; cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    box-shadow: var(--shadow-lg); transition: transform 0.3s ease;
  }
  .cart-fab:hover { transform: scale(1.1); }
  .cart-badge {
    position: absolute; top: -4px; right: -4px;
    background: #ef4444; color: white; font-size: 0.7rem;
    font-weight: 700; width: 20px; height: 20px;
    border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-family: var(--font-body);
  }
</style>

<script>
  function updateCartUI() {
    const btn = document.getElementById('cart-btn')
    const count = document.getElementById('cart-count')
    if (!btn || !count) return
    try {
      const cart = JSON.parse(localStorage.getItem('frescolito-cart') || '[]')
      const total = cart.reduce((s, i) => s + i.quantity, 0)
      btn.style.display = total > 0 ? 'flex' : 'none'
      count.textContent = total
    } catch { btn.style.display = 'none' }
  }

  updateCartUI()
  window.addEventListener('storage', updateCartUI)
  document.addEventListener('cart-updated', updateCartUI)

  document.getElementById('cart-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-cart'))
  })
</script>
