---
import { categories } from '../data/menu'

const catImages = {
  carta: '/imagenes/carrusel/ChatGPT%20Image%2012%20jun%202026,%2012_09_33%20p.m.png',
  promos: '/imagenes/carrusel/WhatsApp%20Image%202026-03-26%20at%2011.19.05%20AM.jpeg',
}

const catIcons = {
  carta: '🍽️',
  promos: '🔥',
}
---

<div class="menu-section" id="menu-section">
  <div class="menu-cats-carousel">
    <div class="swiper-wrapper">
      {categories.map((cat) => (
        <div class="swiper-slide menu-cat-card" data-cat={cat.id}>
          <div class="menu-cat-bg" style={`background-image: url(${catImages[cat.id]})`}></div>
          <div class="menu-cat-overlay"></div>
          <div class="menu-cat-content">
            <span class="menu-cat-icon">{catIcons[cat.id]}</span>
            <h3 class="menu-cat-name">{cat.name}</h3>
            <span class="menu-cat-count">{cat.items.length} platos</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    {categories.map((cat) => (
      <div class="menu-category" id={`cat-${cat.id}`}>
        <div class="menu-grid">
          {cat.items.map((item) => (
            <div class="menu-item">
              <div class="menu-item-body">
                <h3 class="menu-item-name">{item.name}</h3>
                <p class="menu-item-desc">{item.description}</p>
              </div>
              <div class="menu-item-footer">
                <div class="menu-price-block">
                  <span class="menu-item-price">S/ {item.price.toFixed(2)}</span>
                </div>
                <button class="btn btn-primary menu-add-btn" data-id={item.id} data-name={item.name} data-price={item.price}>
                  + Agregar
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .menu-section { padding: var(--space-xl) 0; }

  .menu-cats-carousel {
    overflow-x: auto; display: flex; gap: 1rem;
    padding: 0 var(--space-md) var(--space-xl);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .menu-cats-carousel::-webkit-scrollbar { display: none; }

  .menu-cat-card {
    scroll-snap-align: start;
    flex: 0 0 300px; height: 220px;
    border-radius: var(--radius);
    position: relative; overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .menu-cat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .menu-cat-card.active {
    box-shadow: 0 0 0 3px var(--color-primary), var(--shadow-lg);
  }

  .menu-cat-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: transform 0.4s ease;
  }
  .menu-cat-card:hover .menu-cat-bg { transform: scale(1.08); }

  .menu-cat-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%);
  }

  .menu-cat-content {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.5rem; z-index: 1;
    display: flex; flex-direction: column; gap: 0.25rem;
  }
  .menu-cat-icon { font-size: 2rem; margin-bottom: 0.25rem; }
  .menu-cat-name {
    color: white; font-family: var(--font-heading);
    font-size: 1.3rem; font-weight: 700; margin: 0;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .menu-cat-count {
    color: var(--color-primary); font-size: 0.85rem;
    font-weight: 600; font-family: var(--font-body);
  }

  .menu-category { display: none; }
  .menu-category.active { display: block; }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
  }
  .menu-item {
    background: var(--color-bg); border: 1px solid var(--color-light);
    border-radius: var(--radius); padding: var(--space-lg);
    display: flex; flex-direction: column; justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .menu-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .menu-item-name {
    font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--color-dark);
    font-family: var(--font-heading); font-weight: 700;
  }
  .menu-item-desc {
    color: var(--color-mid); font-size: 0.9rem; line-height: 1.6; margin-bottom: var(--space-md);
  }
  .menu-item-footer {
    display: flex; align-items: center; justify-content: space-between;
  }
  .menu-price-block {
    background: rgba(253,185,19,0.1);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius);
  }
  .menu-item-price {
    font-family: var(--font-heading); font-size: 1.4rem;
    font-weight: 700; color: var(--color-primary-hover);
  }
  .menu-add-btn { font-size: 0.85rem; padding: 0.55rem 1.1rem; }

  @media (max-width: 480px) {
    .menu-item-price { font-size: 1.2rem; }
  }
</style>

<script>
  const cards = document.querySelectorAll('.menu-cat-card')
  const cats = document.querySelectorAll('.menu-category')

  cards.forEach((card, i) => {
    if (i === 0) card.classList.add('active')
    card.addEventListener('click', () => {
      const catId = card.getAttribute('data-cat')
      cards.forEach(c => c.classList.remove('active'))
      card.classList.add('active')
      cats.forEach(c => {
        c.classList.toggle('active', c.id === `cat-${catId}`)
      })
      card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' })
    })
  })

  cats.forEach((cat, i) => {
    if (i === 0) cat.classList.add('active')
    else cat.classList.remove('active')
  })

  document.querySelectorAll('.menu-add-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id')
      const name = btn.getAttribute('data-name')
      const price = parseFloat(btn.getAttribute('data-price'))
      if (!id || !name || !price) return

      const cart = JSON.parse(localStorage.getItem('frescolito-cart') || '[]')
      const existing = cart.find(i => i.id === id)
      if (existing) {
        existing.quantity++
      } else {
        cart.push({ id, name, price, quantity: 1 })
      }
      localStorage.setItem('frescolito-cart', JSON.stringify(cart))
      localStorage.setItem('frescolito-cart-open', 'true')

      btn.style.transform = 'scale(0.9)'
      btn.style.transition = 'transform 0.15s ease'
      setTimeout(() => { btn.style.transform = '' }, 150)
    })
  })
</script>
