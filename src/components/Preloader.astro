---
---

<div class="preloader" id="preloader">
  <div class="preloader-content" id="preloader-content">
    <img src="/imagenes/frescolito.jpeg" alt="FRESCOLITO" class="preloader-logo" />
    <h1 class="preloader-title">FRESCOLITO</h1>
    <p class="preloader-click">Toca cualquier parte para entrar</p>
  </div>
</div>

<style>
  .preloader {
    position: fixed; inset: 0; z-index: 99999;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-dark);
    cursor: pointer;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .preloader.hidden {
    opacity: 0; visibility: hidden;
  }
  .preloader-content {
    text-align: center;
    animation: preloader-fade 0.5s ease;
  }
  .preloader-logo {
    width: 120px; height: 120px; border-radius: 50%; object-fit: cover;
    margin: 0 auto var(--space-md);
    border: 4px solid var(--color-primary);
    box-shadow: 0 0 40px rgba(253,185,19,0.3);
    animation: preloader-pulse 1.2s ease-in-out infinite;
  }
  .preloader-title {
    font-family: 'Pacifico', cursive; font-weight: 400;
    color: var(--color-primary);
    -webkit-text-stroke: 2px var(--color-dark);
    paint-order: stroke fill;
    font-size: 2.5rem;
    text-shadow: 0 4px 16px rgba(0,0,0,0.4);
    margin-bottom: var(--space-md);
  }
  .preloader-click {
    color: rgba(255,255,255,0.5);
    font-family: var(--font-body);
    font-size: 0.85rem;
    animation: preloader-blink 1.5s ease-in-out infinite;
  }
  @keyframes preloader-fade {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes preloader-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 30px rgba(253,185,19,0.2); }
    50% { transform: scale(1.05); box-shadow: 0 0 50px rgba(253,185,19,0.4); }
  }
  @keyframes preloader-blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }
</style>

<script>
  const preloader = document.getElementById('preloader')
  if (preloader) {
    preloader.addEventListener('click', () => {
      preloader.classList.add('hidden')
    })
  }
</script>
