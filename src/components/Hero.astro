---
const images = [
  '/imagenes/galeria/MesaGaleria.webp',
  '/imagenes/galeria/ArrozMarisco.webp',
  '/imagenes/galeria/Chicharron.webp',
  '/imagenes/galeria/Mesacomida.webp',
]
---

<section class="hero" id="hero">
  <div class="swiper-container" id="hero-swiper">
    <div class="swiper-wrapper">
      {images.map((img, i) => (
        <div class="swiper-slide">
          <img
            src={img}
            alt={`Frescolito, cocina regional en Iquitos ${i + 1}`}
            class="hero-slide-img"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <div class="hero-shade"></div>

  <div class="hero-content">
    <div class="hero-inner container">
      <div class="hero-brand">
        <span class="hero-rule" aria-hidden="true"></span>
        <span class="hero-eyebrow">Iquitos · Cocina regional</span>
      </div>
      <h1 class="hero-title">Frescolito</h1>
      <p class="hero-subtitle">
        Ceviches, chicharrones y sabores de la Amazonía preparados al momento,
        con recetas de casa.
      </p>
      <div class="hero-actions">
        <a href="/menu" class="btn btn-primary hero-btn">Ver la carta</a>
        <a href="#" data-pedir class="btn btn-outline hero-btn-ghost">Pedir online</a>
      </div>
      <p class="hero-note">Delivery y recojo en Iquitos · Lunes a viernes, 11:00–15:30</p>
    </div>
  </div>

  <div class="hero-caption" aria-hidden="true">
    <span class="hero-caption-line"></span>
    <span>Sazón de casa desde 2014</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: min(780px, 94vh);
    min-height: 560px;
    overflow: hidden;
    background: #241d19;
  }
  .swiper-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(26, 20, 17, 0.78) 0%, rgba(26, 20, 17, 0.45) 46%, rgba(26, 20, 17, 0.08) 78%),
      linear-gradient(0deg, rgba(26, 20, 17, 0.38) 0%, transparent 44%);
  }
  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-top: 70px;
  }
  .hero-inner {
    width: 100%;
    text-align: left;
    animation: hero-in 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .hero-rule {
    width: 36px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
  }
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }
  .hero-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3.4rem, 7.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .hero-subtitle {
    max-width: 46ch;
    margin: 0 0 1.75rem;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.35vw, 1.12rem);
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .hero-btn,
  .hero-btn-ghost {
    font-size: 0.86rem;
    padding: 0.78rem 1.5rem;
  }
  .hero-btn-ghost {
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }
  .hero-btn-ghost:hover {
    background: #fff;
    border-color: #fff;
    color: var(--color-dark);
  }
  .hero-note {
    margin: 1.15rem 0 0;
    font-family: var(--font-body);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.62);
  }
  .hero-caption {
    position: absolute;
    right: 1.5rem;
    bottom: 1.6rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.56);
  }
  .hero-caption-line {
    width: 30px;
    height: 1px;
    background: rgba(255, 255, 255, 0.42);
  }

  .swiper-pagination { bottom: 26px !important; }
  .swiper-pagination-bullet {
    width: 20px;
    height: 2px;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.4);
    opacity: 1;
    transition: background 0.25s ease;
  }
  .swiper-pagination-bullet-active {
    width: 20px;
    background: var(--color-primary);
  }

  @media (max-width: 768px) {
    .hero { height: min(700px, 92vh); min-height: 520px; }
    .hero-shade {
      background:
        linear-gradient(180deg, rgba(26, 20, 17, 0.55) 0%, rgba(26, 20, 17, 0.72) 58%, rgba(26, 20, 17, 0.9) 100%);
    }
    .hero-content { padding-top: 56px; }
    .hero-title { font-size: clamp(2.9rem, 13vw, 4rem); }
    .hero-subtitle { margin-bottom: 1.4rem; }
    .hero-caption { display: none; }
    .hero-btn,
    .hero-btn-ghost { flex: 1; }
    .swiper-pagination { bottom: 18px !important; }
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Autoplay, Pagination } from 'swiper/modules'
  import 'swiper/css'

  new Swiper('#hero-swiper', {
    modules: [Autoplay, Pagination],
    autoplay: { delay: 6500, disableOnInteraction: false },
    pagination: { el: '.swiper-pagination', clickable: true },
    effect: 'fade',
    fadeEffect: { crossFade: true },
    speed: 900,
    loop: true,
  })
</script>
