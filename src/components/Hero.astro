---
import { SITE_DESCRIPTION } from '../data/config'

const images = [
  'imagenes/carrusel/ChatGPT Image 12 jun 2026, 11_19_56 a.m.png',
  'imagenes/carrusel/ChatGPT Image 12 jun 2026, 11_44_43 a.m.png',
  'imagenes/carrusel/ChatGPT Image 12 jun 2026, 12_06_44 p.m.png',
  'imagenes/carrusel/ChatGPT Image 12 jun 2026, 12_09_33 p.m.png',
]
---

<section class="hero" id="hero">
  <div class="swiper-container" id="hero-swiper">
    <div class="swiper-wrapper">
      {images.map((img, i) => (
        <div class="swiper-slide">
          <img src={img} alt={`FRESCOLITO ${i + 1}`} class="hero-slide-img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="hero-slide-overlay"></div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <div class="hero-content">
    <img src="/imagenes/frescolito.jpeg" alt="FRESCOLITO" class="hero-logo" />
    <h1 class="hero-title">FRESCOLITO</h1>
    <p class="hero-subtitle">{SITE_DESCRIPTION}</p>
    <div class="hero-actions">
      <a href="/menu" class="btn btn-primary hero-btn">Ver Menú</a>
      <a href="/reservas" class="btn btn-outline hero-btn-oul">Reserva Ahora</a>
    </div>
  </div>

  <div class="hero-scroll">
    <span class="hero-scroll-text">Desliza para explorar</span>
    <span class="hero-scroll-arrow">⌄</span>
  </div>
</section>

<style>
  .hero {
    height: 100vh; position: relative; overflow: hidden;
  }
  .swiper-container {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .hero-slide-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .hero-slide-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0.5) 100%);
  }
  .hero-content {
    text-align: center; position: relative; z-index: 2;
    padding: 0 var(--space-md);
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; height: 100%;
    animation: hero-in 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s both;
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-logo {
    width: 150px; height: 150px; border-radius: 50%; object-fit: cover;
    margin-bottom: var(--space-lg); border: 4px solid var(--color-primary);
    box-shadow: 0 0 40px rgba(253,185,19,0.3);
  }
  .hero-title {
    font-family: 'Pacifico', cursive;
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 6rem);
    color: var(--color-primary);
    -webkit-text-stroke: 3px var(--color-dark);
    paint-order: stroke fill;
    text-shadow: 0 4px 16px rgba(0,0,0,0.4);
    margin-bottom: var(--space-md);
    line-height: 1.1;
  }
  .hero-subtitle {
    color: white;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-family: var(--font-body);
    font-weight: 300;
    max-width: 600px; margin: 0 auto var(--space-lg);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }
  .hero-actions { display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; }
  .hero-btn { font-size: 1.1rem; padding: 1rem 2.5rem; }
  .hero-btn-oul {
    font-size: 1.1rem; padding: 1rem 2.5rem;
    border-color: var(--color-primary); color: var(--color-primary);
  }
  .hero-btn-oul:hover { background: var(--color-primary); color: var(--color-dark); }
  .hero-btn-oul:active { background: var(--color-primary); color: #5a2a0a; }

  .hero-scroll {
    position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%);
    z-index: 2; display: flex; flex-direction: column; align-items: center;
    gap: 4px; animation: bounce 2s ease-in-out infinite;
  }
  .hero-scroll-text {
    color: rgba(255,255,255,0.7); font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 2px;
    font-family: var(--font-body); font-weight: 600;
  }
  .hero-scroll-arrow {
    color: var(--color-primary); font-size: 1.5rem; line-height: 1;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  .swiper-pagination { bottom: 30px !important; }
  .swiper-pagination-bullet {
    width: 10px; height: 10px; background: rgba(255,255,255,0.5);
    opacity: 1; transition: all 0.3s ease;
  }
  .swiper-pagination-bullet-active {
    background: var(--color-primary); width: 28px; border-radius: 5px;
  }

  @media (max-width: 768px) {
    .hero-title { -webkit-text-stroke: 2px var(--color-dark); }
    .hero-logo { width: 120px; height: 120px; }
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Autoplay, Pagination } from 'swiper/modules'
  import 'swiper/css'

  new Swiper('#hero-swiper', {
    modules: [Autoplay, Pagination],
    autoplay: { delay: 5000, disableOnInteraction: false },
    pagination: { el: '.swiper-pagination', clickable: true },
    effect: 'fade',
    fadeEffect: { crossFade: true },
    speed: 800,
    loop: true,
  })

  const hero = document.getElementById('hero')
  if (hero) {
    const heroBg = hero.querySelector('.swiper-container')
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY
      const maxParallax = 150
      if (scrolled < window.innerHeight) {
        heroBg.style.transform = `translateY(${Math.min(scrolled * 0.3, maxParallax)}px)`
      }
    }, { passive: true })
  }
</script>
