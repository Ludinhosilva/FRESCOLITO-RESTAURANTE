# Variables de entorno del sitio (Supabase)
#
# LOCAL:
#   Copia este archivo a .env y usa el proyecto de STAGING.
#
# VERCEL (Settings -> Environment Variables), por entorno:
#   Production -> Supabase PROD
#   Preview    -> Supabase STAGING
#   (asi las Preview URLs de las ramas no tocan produccion)

PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Conexion directa a la BD para correr migraciones (scripts/migrate.mjs).
# Usa el POOLER (IPv4 seguro). Reemplaza TU-CONTRASENA por la contraseña
# de la BD: Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres.ukuaaybbnovuywbcklha:TU-CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
